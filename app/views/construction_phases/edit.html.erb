<div class="flex items-center gap-3 mb-6">
  <%= link_to home_construction_path(@construction), class: "text-gray-400 hover:text-gray-600 transition" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  <% end %>
  <div>
    <h1 class="text-xl font-bold text-gray-900 font-['Playfair_Display']">Update Phase: <%= @phase.name %></h1>
    <p class="text-sm text-gray-400 mt-0.5"><%= @construction.name %></p>
  </div>
</div>

<div class="max-w-2xl">
  <%= render 'form', phase: @phase %>
</div>
