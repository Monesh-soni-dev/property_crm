<% content_for :title, "Reports & Analytics" %>

<style>
  .reports-hero { background: linear-gradient(135deg, #1e3a5f 0%, #0f2440 50%, #0a1628 100%); border-radius: 1.25rem; padding: 2rem 2.5rem; margin-bottom: 2rem; position: relative; overflow: hidden; }
  .reports-hero::before { content: ''; position: absolute; top: -50%; right: -20%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%); border-radius: 50%; }
  .reports-hero h1 { color: #fff; font-size: 1.75rem; font-weight: 700; font-family: 'Playfair Display', serif; }
  .reports-hero p { color: #94a3b8; font-size: 0.9rem; margin-top: 0.25rem; }

  .filter-card { background: #fff; border-radius: 1rem; padding: 1.5rem 2rem; box-shadow: 0 4px 24px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; margin-bottom: 2rem; }
  .filter-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; }
  .filter-group label { display: block; font-size: 0.75rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem; }
  .filter-group select, .filter-group input { padding: 0.6rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.625rem; font-size: 0.875rem; background: #f8fafc; transition: all 0.2s; outline: none; min-width: 160px; }
  .filter-group select:focus, .filter-group input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
  .btn-filter { padding: 0.6rem 1.5rem; background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; border: none; border-radius: 0.625rem; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.5rem; }
  .btn-filter:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,0.35); }

  .date-range-badge { display: inline-flex; align-items: center; gap: 0.4rem; background: linear-gradient(135deg,#eff6ff,#dbeafe); color: #1d4ed8; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.85rem; border-radius: 2rem; }

  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .stat-card { background: #fff; border-radius: 1rem; padding: 1.25rem 1.5rem; border: 1px solid #e2e8f0; box-shadow: 0 2px 12px rgba(0,0,0,0.04); transition: all 0.25s; position: relative; overflow: hidden; }
  .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
  .stat-card .accent { position: absolute; top: 0; left: 0; width: 4px; height: 100%; border-radius: 4px 0 0 4px; }
  .stat-card .label { font-size: 0.75rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }
  .stat-card .value { font-size: 1.65rem; font-weight: 700; color: #0f172a; margin-top: 0.25rem; }

  .report-table-wrap { background: #fff; border-radius: 1rem; border: 1px solid #e2e8f0; box-shadow: 0 2px 12px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
  .report-table-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #f1f5f9; }
  .report-table-header h3 { font-size: 1rem; font-weight: 700; color: #0f172a; }
  .btn-csv { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 1rem; background: linear-gradient(135deg,#059669,#047857); color: #fff; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: all 0.2s; border: none; cursor: pointer; }
  .btn-csv:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(5,150,105,0.35); }

  table.report-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  table.report-table thead { background: #f8fafc; }
  table.report-table th { padding: 0.75rem 1rem; text-align: left; font-weight: 600; color: #475569; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 2px solid #e2e8f0; }
  table.report-table td { padding: 0.7rem 1rem; border-bottom: 1px solid #f1f5f9; color: #334155; }
  table.report-table tbody tr:hover { background: #f8fafc; }

  .stage-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 1rem; font-size: 0.7rem; font-weight: 600; }
  .stage-new_lead { background: #dbeafe; color: #1d4ed8; }
  .stage-contacted { background: #fef3c7; color: #92400e; }
  .stage-interested { background: #d1fae5; color: #065f46; }
  .stage-visit_scheduled { background: #e0e7ff; color: #3730a3; }
  .stage-negotiation { background: #fce7f3; color: #9d174d; }
  .stage-closed { background: #d1fae5; color: #065f46; }
  .stage-rejected { background: #fee2e2; color: #991b1b; }
  .status-available { background: #d1fae5; color: #065f46; }
  .status-blocked { background: #fef3c7; color: #92400e; }
  .status-booked { background: #dbeafe; color: #1d4ed8; }
  .status-registered { background: #e0e7ff; color: #3730a3; }
  .status-sold { background: #fee2e2; color: #991b1b; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
  .empty-state svg { width: 48px; height: 48px; margin: 0 auto 1rem; opacity: 0.4; }

  .custom-dates { display: none; }
  .custom-dates.visible { display: flex; gap: 1rem; }

  .tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .tab-btn { padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; transition: all 0.2s; }
  .tab-btn.active { background: linear-gradient(135deg,#3b82f6,#2563eb); color: #fff; border-color: #3b82f6; box-shadow: 0 2px 8px rgba(37,99,235,0.25); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 640px) {
    .reports-hero { padding: 1.25rem; border-radius: 1rem; }
    .reports-hero h1 { font-size: 1.25rem; }
    .filter-card { padding: 1rem; }
    .filter-row { flex-direction: column; }
    .filter-group select, .filter-group input { width: 100%; }
    .stats-grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .stat-card { padding: 1rem; }
    .stat-card .value { font-size: 1.25rem; }
    .report-table-wrap { border-radius: 0.75rem; overflow-x: auto; }
    table.report-table { min-width: 600px; }
  }
</style>

<!-- ═══ Hero ═══ -->
<div class="reports-hero">
  <h1>📊 Reports & Analytics</h1>
  <p>Filter your data by date range and download CSV exports</p>
  <div style="margin-top:0.75rem;">
    <span class="date-range-badge">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <%= @start_date.strftime('%d %b %Y') %> — <%= @end_date.strftime('%d %b %Y') %>
    </span>
  </div>
</div>

<!-- ═══ Filter Card ═══ -->
<div class="filter-card">
  <%= form_tag reports_path, method: :get, id: "report-filter-form" do %>
    <div class="filter-row">
      <div class="filter-group">
        <label for="range-select">Date Range</label>
        <select name="range" id="range-select">
          <option value="all"       <%= 'selected' if @range_preset == 'all' %>>All Time</option>
          <option value="yesterday" <%= 'selected' if @range_preset == 'yesterday' %>>Yesterday</option>
          <option value="1_week"    <%= 'selected' if @range_preset == '1_week' %>>Last 7 Days</option>
          <option value="custom"    <%= 'selected' if @range_preset == 'custom' %>>Custom Range</option>
        </select>
      </div>
      <div class="custom-dates <%= 'visible' if @range_preset == 'custom' %>" id="custom-dates">
        <div class="filter-group">
          <label for="start_date">From</label>
          <input type="date" name="start_date" id="start_date" value="<%= params[:start_date] || @start_date %>">
        </div>
        <div class="filter-group">
          <label for="end_date">To</label>
          <input type="date" name="end_date" id="end_date" value="<%= params[:end_date] || @end_date %>">
        </div>
      </div>
      <button type="submit" class="btn-filter">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        Generate Report
      </button>
    </div>
  <% end %>
</div>

<!-- ═══ Summary Cards ═══ -->
<div class="stats-grid">
  <div class="stat-card"><div class="accent" style="background:#3b82f6;"></div><div class="label">Total Leads</div><div class="value"><%= @total_leads %></div></div>
  <div class="stat-card"><div class="accent" style="background:#8b5cf6;"></div><div class="label">Properties</div><div class="value"><%= @total_properties %></div></div>
  <div class="stat-card"><div class="accent" style="background:#059669;"></div><div class="label">Avg Price</div><div class="value">₹<%= number_to_human(@avg_price, units: { thousand: 'K', million: 'M', billion: 'B' }) %></div></div>
  <div class="stat-card"><div class="accent" style="background:#f59e0b;"></div><div class="label">Total Costs</div><div class="value">₹<%= number_to_human(@total_costs_amount, units: { thousand: 'K', million: 'M', billion: 'B' }) %></div></div>
  <div class="stat-card"><div class="accent" style="background:#ec4899;"></div><div class="label">Price / sqft</div><div class="value">₹<%= number_with_delimiter(@avg_price_per_sq_ft) %></div></div>
</div>

<% 
  active_tab = 'leads-tab'
  if params[:costs_page].present?
    active_tab = 'costs-tab'
  elsif params[:properties_page].present?
    active_tab = 'properties-tab'
  end
%>
<!-- ═══ Tabs ═══ -->
<div class="tabs">
  <button class="tab-btn <%= 'active' if active_tab == 'leads-tab' %>" data-tab="leads-tab">Leads Report</button>
  <button class="tab-btn <%= 'active' if active_tab == 'properties-tab' %>" data-tab="properties-tab">Properties Report</button>
  <button class="tab-btn <%= 'active' if active_tab == 'costs-tab' %>" data-tab="costs-tab">Costs Report</button>
</div>

<!-- ══════════════ Leads Tab ══════════════ -->
<div class="tab-panel <%= 'active' if active_tab == 'leads-tab' %>" id="leads-tab">
  <div class="report-table-wrap">
    <div class="report-table-header">
      <h3>Leads (<%= @total_leads %>)</h3>
      <%= link_to reports_path(range: @range_preset, start_date: params[:start_date], end_date: params[:end_date], report_type: 'leads', format: :csv), class: 'btn-csv' do %>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download CSV
      <% end %>
    </div>
    <% if @leads.any? %>
      <div style="overflow-x:auto;">
        <table class="report-table">
          <thead><tr><th>#</th><th>Customer</th><th>Phone</th><th>Email</th><th>Stage</th><th>Project</th><th>Follow Up</th><th>Created</th></tr></thead>
          <tbody>
            <% @leads.each_with_index do |lead, i| %>
              <tr>
                <td><%= @pagy_leads.from + i %></td>
                <td style="font-weight:600;"><%= lead.customer_name %></td>
                <td><%= lead.customer_phone %></td>
                <td><%= lead.customer_email || '—' %></td>
                <td><span class="stage-badge stage-<%= lead.stage %>"><%= lead.stage&.titleize %></span></td>
                <td><%= lead.project&.name || '—' %></td>
                <td><%= lead.follow_up_date&.strftime('%d %b %Y') || '—' %></td>
                <td><%= lead.created_at.strftime('%d %b %Y') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render 'reports/pagination', pagy: @pagy_leads, page_param: 'leads_page', label: 'leads' %>
    <% else %>
      <div class="empty-state">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p>No leads found for this date range.</p>
      </div>
    <% end %>
  </div>

  <% if @leads.any? %>
  <div class="report-table-wrap">
    <div class="report-table-header"><h3>Leads by Stage</h3></div>
    <table class="report-table">
      <thead><tr><th>Stage</th><th>Count</th><th>Percentage</th></tr></thead>
      <tbody>
        <% @leads_by_stage.each do |stage, count| %>
          <tr>
            <td><span class="stage-badge stage-<%= stage %>"><%= stage.titleize %></span></td>
            <td style="font-weight:600;"><%= count %></td>
            <td><%= @total_leads > 0 ? ((count.to_f / @total_leads) * 100).round(1) : 0 %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

<!-- ══════════════ Properties Tab ══════════════ -->
<div class="tab-panel <%= 'active' if active_tab == 'properties-tab' %>" id="properties-tab">
  <div class="report-table-wrap">
    <div class="report-table-header">
      <h3>Properties (<%= @total_properties %>)</h3>
      <%= link_to reports_path(range: @range_preset, start_date: params[:start_date], end_date: params[:end_date], report_type: 'properties', format: :csv), class: 'btn-csv' do %>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download CSV
      <% end %>
    </div>
    <% if @properties.any? %>
      <div style="overflow-x:auto;">
        <table class="report-table">
          <thead><tr><th>#</th><th>Title</th><th>Unit</th><th>Type</th><th>Status</th><th>Price (₹)</th><th>Area</th><th>City</th><th>Created</th></tr></thead>
          <tbody>
            <% @properties.each_with_index do |prop, i| %>
              <tr>
                <td><%= @pagy_properties.from + i %></td>
                <td style="font-weight:600;"><%= prop.title %></td>
                <td><%= prop.unit_number %></td>
                <td><%= prop.property_type&.titleize %></td>
                <td><span class="stage-badge status-<%= prop.status %>"><%= prop.status&.titleize %></span></td>
                <td>₹<%= number_with_delimiter(prop.price) %></td>
                <td><%= prop.area %> sqft</td>
                <td><%= prop.city %></td>
                <td><%= prop.created_at.strftime('%d %b %Y') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render 'reports/pagination', pagy: @pagy_properties, page_param: 'properties_page', label: 'properties' %>
    <% else %>
      <div class="empty-state">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <p>No properties found for this date range.</p>
      </div>
    <% end %>
  </div>

  <% if @properties.any? %>
  <div class="report-table-wrap">
    <div class="report-table-header"><h3>Properties by Status</h3></div>
    <table class="report-table">
      <thead><tr><th>Status</th><th>Count</th><th>Percentage</th></tr></thead>
      <tbody>
        <% @properties_by_status.each do |status, count| %>
          <tr>
            <td><span class="stage-badge status-<%= status %>"><%= status.titleize %></span></td>
            <td style="font-weight:600;"><%= count %></td>
            <td><%= @total_properties > 0 ? ((count.to_f / @total_properties) * 100).round(1) : 0 %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

<!-- ══════════════ Costs Tab ══════════════ -->
<div class="tab-panel <%= 'active' if active_tab == 'costs-tab' %>" id="costs-tab">
  <div class="report-table-wrap">
    <div class="report-table-header">
      <h3>Costs (₹<%= number_with_delimiter(@total_costs_amount.round(0)) %>)</h3>
      <%= link_to reports_path(range: @range_preset, start_date: params[:start_date], end_date: params[:end_date], report_type: 'costs', format: :csv), class: 'btn-csv' do %>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download CSV
      <% end %>
    </div>
    <% if @costs.any? %>
      <div style="overflow-x:auto;">
        <table class="report-table">
          <thead><tr><th>#</th><th>Title</th><th>Category</th><th>Amount (₹)</th><th>Date</th><th>Project</th><th>Created</th></tr></thead>
          <tbody>
            <% @costs.each_with_index do |cost, i| %>
              <tr>
                <td><%= @pagy_costs.from + i %></td>
                <td style="font-weight:600;"><%= cost.title %></td>
                <td><%= cost.category&.titleize %></td>
                <td>₹<%= number_with_delimiter(cost.amount) %></td>
                <td><%= cost.cost_date&.strftime('%d %b %Y') %></td>
                <td><%= cost.project&.name || '—' %></td>
                <td><%= cost.created_at.strftime('%d %b %Y') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render 'reports/pagination', pagy: @pagy_costs, page_param: 'costs_page', label: 'costs' %>
    <% else %>
      <div class="empty-state">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p>No costs found for this date range.</p>
      </div>
    <% end %>
  </div>

  <% if @costs.any? %>
  <div class="report-table-wrap">
    <div class="report-table-header"><h3>Costs by Category</h3></div>
    <table class="report-table">
      <thead><tr><th>Category</th><th>Amount (₹)</th><th>Share</th></tr></thead>
      <tbody>
        <% @costs_by_category.reject { |_, v| v == 0 }.sort_by { |_, v| -v }.each do |cat, amt| %>
          <tr>
            <td style="font-weight:600;"><%= cat.titleize %></td>
            <td>₹<%= number_with_delimiter(amt.round(0)) %></td>
            <td><%= @total_costs_amount > 0 ? ((amt / @total_costs_amount) * 100).round(1) : 0 %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Toggle custom date inputs
  var rangeSelect = document.getElementById('range-select');
  var customDates = document.getElementById('custom-dates');
  if (rangeSelect && customDates) {
    rangeSelect.addEventListener('change', function() {
      customDates.classList.toggle('visible', this.value === 'custom');
    });
  }

  // Tabs
  document.querySelectorAll('.tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      this.classList.add('active');
      document.getElementById(this.dataset.tab).classList.add('active');
    });
  });
});
</script>