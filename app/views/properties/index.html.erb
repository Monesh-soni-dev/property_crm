
<% if user_signed_in? %>
  <% breadcrumbs ["Dashboard", root_path], ["Projects", projects_path], ["Properties", "#"] %>
<% else %>
  <% breadcrumbs ["Properties", "#"] %>
<% end %>

<!-- Page Header -->
<div class="bg-gradient-to-r from-slate-900 to-blue-900 rounded-3xl p-8 mb-8 text-white">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-4xl font-['Playfair_Display'] font-bold mb-2">
        <%= @project.present? ? "Properties in #{@project.name}" : "All Properties" %>
      </h1>
      <div class="flex items-center gap-6 text-blue-200">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <%= @pagy ? @pagy.count : @properties.count %> Properties Available
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <%= @project&.name || "Multiple Projects" %>
        </span>
      </div>
    </div>
    
    <div class="flex gap-3">
      <% if user_signed_in? && !current_user.customer? %>
        <%= link_to new_property_path, class: "flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition-all transform hover:scale-105 shadow-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Property
        <% end %>
        <%= link_to new_project_path, class: "flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-semibold transition-all transform hover:scale-105 shadow-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          Add Project
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Filters Section -->
<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200 mb-8">
  <%= search_form_for @q, url: properties_path, class: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3 items-end" do |f| %>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">City</label>
      <%= f.search_field :city_cont, placeholder: "e.g. Mumbai, Pune",
            class: "w-full border border-gray-300 rounded-xl px-3 py-2.5 bg-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Project Name</label>
      <%= f.search_field :project_name_cont, placeholder: "e.g. Sunrise Residency",
            class: "w-full border border-gray-300 rounded-xl px-3 py-2.5 bg-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Property Type</label>
      <%= f.select :property_type_eq, [
            ['1BHK Apartment', '1bhk'],
            ['2BHK Apartment', '2bhk'],
            ['3BHK Apartment', '3bhk'],
            ['4BHK Apartment', '4bhk'],
            ['Apartment', 'apartment'],
            ['Villa', 'villa'],
            ['Plot / Land', 'plot'],
            ['Commercial', 'commercial'],
            ['Commercial Office', 'commercial_office'],
            ['Commercial Shop', 'commercial_shop'],
            ['Warehouse', 'warehouse'],
            ['Duplex', 'duplex'],
            ['Penthouse', 'penthouse'],
            ['Studio', 'studio']
          ],
            { include_blank: "All Types" },
            class: "w-full border border-gray-300 rounded-xl px-3 py-2.5 bg-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Search", class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-sm cursor-pointer" %>
      <%= link_to "Clear", request.path, class: "flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all" %>
    </div>

  <% end %>
</div>

<!-- Properties Grid -->
<% if @properties && @properties.any? %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @properties.each do |property| %>
    <div class="group block h-full">
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-200 hover:border-blue-300 flex flex-col h-full">
        <% images = property.images.attached? ? property.images.to_a : [] %>
        <% carousel_id = "carousel-#{property.id}" %>
        <div class="relative h-56 flex-shrink-0 bg-gradient-to-br from-slate-100 to-slate-200 overflow-hidden"
             <% if images.size > 1 %>data-carousel="<%= carousel_id %>"<% end %>>

          <%# ─── Image strip (slides) ─── %>
          <% if images.any? %>
            <div id="<%= carousel_id %>-track"
                 class="flex h-full transition-transform duration-500 ease-in-out"
                 style="width:<%= images.size * 100 %>%; transform:translateX(0%)">
              <% images.each_with_index do |img, i| %>
                <div class="h-full flex-shrink-0" style="width:<%= 100.0 / images.size %>%">
                  <% if user_signed_in? %>
                    <% property_url = @project ? project_property_path(@project, property) : property_path(property) %>
                    <%= link_to property_url, class: "block w-full h-full" do %>
                      <%= image_tag img, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700", loading: "lazy" %>
                    <% end %>
                  <% else %>
                    <%= image_tag img, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700", loading: "lazy" %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%# ─── Dot indicators (only when multiple images) ─── %>
            <% if images.size > 1 %>
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
                <% images.each_with_index do |_, i| %>
                  <button type="button"
                          onclick="propCarouselGoTo('<%= carousel_id %>', <%= i %>, <%= images.size %>); event.preventDefault(); event.stopPropagation();"
                          class="carousel-dot w-1.5 h-1.5 rounded-full transition-all duration-300 <%= i == 0 ? 'bg-white scale-125' : 'bg-white/50' %>"
                          id="<%= carousel_id %>-dot-<%= i %>"
                          aria-label="Image <%= i + 1 %>"></button>
                <% end %>
              </div>
            <% end %>

          <% else %>
            <%# No images placeholder %>
            <% if user_signed_in? %>
              <% property_url = @project ? project_property_path(@project, property) : property_path(property) %>
              <%= link_to property_url, class: "flex items-center justify-center w-full h-full" do %>
                <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              <% end %>
            <% else %>
              <div class="flex items-center justify-center h-full">
                <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
            <% end %>
          <% end %>
          
          <!-- Status Badge -->
          <div class="absolute top-4 right-4">
            <span class="px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide backdrop-blur-md
              <%= case property.status
                  when 'available' then 'bg-emerald-500/90 text-white'
                  when 'sold' then 'bg-rose-500/90 text-white'
                  when 'blocked' then 'bg-amber-500/90 text-white'
                  when 'booked' then 'bg-blue-500/90 text-white'
                  when 'registered' then 'bg-purple-500/90 text-white'
                  else 'bg-gray-500/90 text-white'
                  end %>">
              <%= property.status&.humanize || 'Unknown' %>
            </span>
          </div>
          
          <!-- Property Type Badge -->
          <div class="absolute top-4 left-4">
            <span class="px-3 py-1.5 bg-white/90 backdrop-blur-md text-gray-800 text-xs font-semibold rounded-full">
              <%= format_property_type(property.property_type) %>
            </span>
          </div>
          
          <!-- Quick Actions (for authenticated users) -->
          <% if user_signed_in? && (property.project.user == current_user || current_user.admin?) %>
            <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="flex gap-2">
                <%= link_to (@project ? edit_project_property_path(@project, property) : edit_property_path(property)), 
                    class: "p-2 bg-white/90 backdrop-blur-md rounded-full hover:bg-white transition-all", 
                    onclick: "event.stopPropagation(); event.preventDefault(); window.location.href = this.href;" do %>
                  <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        
        <!-- Card Body — flex-col + flex-1 so all cards stretch to equal height -->
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-start justify-between mb-3">
            <div class="flex-1 min-w-0 pr-3">
              <h3 class="font-bold text-xl text-gray-900 group-hover:text-blue-600 transition-colors truncate"><%= property.title %></h3>
              <div class="flex items-center text-gray-500 text-sm mt-1">
                <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="truncate">
                  <%= property.project.name %><% if property.city.present? %> &bull; <%= property.city %><% end %>
                </span>
              </div>
            </div>
            <div class="text-right flex-shrink-0">
              <% if property.price.present? && property.price > 0 %>
                <p class="text-xl font-bold text-blue-600 whitespace-nowrap"><%= format_price(property.price) %></p>
              <% else %>
                <p class="text-base font-bold text-gray-400 whitespace-nowrap">Price not set</p>
              <% end %>
              <p class="text-xs text-gray-500">Total Price</p>
            </div>
          </div>
          
          <!-- Description — fixed 2-line clamp, always occupies the same space -->
          <div class="mb-4 min-h-[2.5rem]">
            <% if property.description.present? %>
              <p class="text-gray-600 text-sm line-clamp-2"><%= truncate(property.description, length: 120) %></p>
            <% else %>
              <p class="text-gray-400 text-sm italic">No description available</p>
            <% end %>
          </div>
          
          <!-- Stats + CTA — pushed to bottom with mt-auto -->
          <div class="mt-auto flex items-center justify-between pt-4 border-t border-gray-100">
            <% is_plot        = %w[plot].include?(property.property_type.to_s) %>
            <% is_commercial  = %w[commercial commercial_office commercial_shop warehouse].include?(property.property_type.to_s) %>
            <% is_residential = !is_plot && !is_commercial %>

            <div class="flex items-center gap-3 text-sm text-gray-600 flex-wrap">

              <%# Area — shown for all types when present %>
              <% if property.area.present? && property.area.to_i > 0 %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"></path>
                  </svg>
                  <%= property.area %> sq ft
                </span>
              <% end %>

              <%# BHK — only for residential types %>
              <% if is_residential && property.bedrooms.present? && property.bedrooms.to_i > 0 %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                  </svg>
                  <%= property.bedrooms %> BHK
                </span>
              <% end %>

              <%# Bath — only for residential types %>
              <% if is_residential && property.bathrooms.present? && property.bathrooms.to_i > 0 %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
                  </svg>
                  <%= property.bathrooms %> Bath
                </span>
              <% end %>

              <%# Fallback when no stats available %>
              <% no_area = !property.area.present? || property.area.to_i == 0 %>
              <% no_bhk  = !is_residential || !property.bedrooms.present? || property.bedrooms.to_i == 0 %>
              <% if no_area && no_bhk %>
                <span class="text-gray-400 italic text-xs">No size info</span>
              <% end %>
            </div>
            
            <div class="flex items-center text-blue-600 font-medium text-sm flex-shrink-0 ml-2">
              <% if user_signed_in? %>
                <% property_url = @project ? project_property_path(@project, property) : property_path(property) %>
                <%= link_to property_url, class: "flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm cursor-pointer whitespace-nowrap" do %>
                  View Details
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                <% end %>
              <% else %>
                <%= link_to new_user_registration_path, class: "flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm cursor-pointer whitespace-nowrap" do %>
                  Sign Up to View
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @pagy && @pagy.pages > 1 %>
    <div class="mt-10 pt-6 border-t border-gray-200">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">

        <!-- Left: count info -->
        <p class="text-sm text-gray-500 order-2 sm:order-1">
          Showing
          <span class="font-semibold text-gray-800"><%= @pagy.from %></span>
          –
          <span class="font-semibold text-gray-800"><%= @pagy.to %></span>
          of
          <span class="font-semibold text-gray-800"><%= @pagy.count %></span>
          properties
        </p>

        <!-- Right: page buttons -->
        <div class="flex items-center gap-1.5 order-1 sm:order-2">

          <%# Prev button %>
          <% if @pagy.previous %>
            <% prev_url = @pagy.previous == 1 ? url_for(request.query_parameters.except("page")) : url_for(request.query_parameters.merge("page" => @pagy.previous)) %>
            <%= link_to prev_url, class: "inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-600 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              <span class="hidden sm:inline">Prev</span>
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-200 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              <span class="hidden sm:inline">Prev</span>
            </span>
          <% end %>

          <%# Page number buttons %>
          <% pagy_series(@pagy).each do |item| %>
            <% if item == :gap %>
              <span class="inline-flex items-center justify-center w-9 h-9 text-gray-400 text-sm select-none">…</span>
            <% elsif item.is_a?(String) %>
              <%# Current page (Pagy returns current page as String) %>
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-600 text-white text-sm font-bold shadow-md ring-2 ring-blue-200">
                <%= item %>
              </span>
            <% else %>
              <%# Other page numbers (Integer) %>
              <% page_url = item == 1 ? url_for(request.query_parameters.except("page")) : url_for(request.query_parameters.merge("page" => item)) %>
              <%= link_to item, page_url,
                    class: "inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" %>
            <% end %>
          <% end %>

          <%# Next button %>
          <% if @pagy.next %>
            <% next_url = url_for(request.query_parameters.merge("page" => @pagy.next)) %>
            <%= link_to next_url, class: "inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-600 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" do %>
              <span class="hidden sm:inline">Next</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-200 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed shadow-sm">
              <span class="hidden sm:inline">Next</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          <% end %>

        </div>
      </div>
    </div>
  <% end %>
</div>
<% else %>
<!-- Empty State -->
<div class="bg-white rounded-3xl p-12 text-center border border-gray-200">
  <div class="text-6xl mb-6">🏠</div>
  <h3 class="text-2xl font-bold text-gray-900 mb-4">No Properties Found</h3>
  <p class="text-gray-600 mb-6">
    <% if params[:q].present? %>
      No properties match your search criteria. Try adjusting your filters.
    <% else %>
      There are no properties available at the moment.
    <% end %>
  </p>
  <% if user_signed_in? && !current_user.customer? %>
    <%= link_to "Add Property", new_property_path, class: "bg-blue-600 text-white px-6 py-3 rounded-xl font-medium hover:bg-blue-700 transition-all" %>
  <% end %>
</div>
<% end %>

<script>
  // ─── Property Card Image Carousel ───
  (function() {
    var timers = {};

    // Go to a specific slide
    window.propCarouselGoTo = function(carouselId, index, total) {
      var track = document.getElementById(carouselId + '-track');
      if (!track) return;

      var pct = -(index * (100 / total));
      track.style.transform = 'translateX(' + pct + '%)';

      // Update dots
      for (var i = 0; i < total; i++) {
        var dot = document.getElementById(carouselId + '-dot-' + i);
        if (dot) {
          if (i === index) {
            dot.className = dot.className.replace('bg-white/50', 'bg-white').replace(/scale-\d+/, 'scale-125');
            if (dot.className.indexOf('scale-125') === -1) dot.className += ' scale-125';
            if (dot.className.indexOf('bg-white ') === -1 && dot.className.indexOf('bg-white"') === -1) {
              dot.className = dot.className.replace('bg-white/50', 'bg-white');
            }
          } else {
            dot.className = dot.className.replace('bg-white ', 'bg-white/50 ').replace('scale-125', '');
            if (dot.className.indexOf('bg-white/50') === -1) {
              dot.className = dot.className.replace('bg-white', 'bg-white/50');
            }
          }
        }
      }

      // Store current index on the track element
      track.dataset.currentIndex = index;
    };

    function startAutoSlide(container, carouselId) {
      var track = document.getElementById(carouselId + '-track');
      if (!track) return;

      var total = track.children.length;
      if (total <= 1) return;

      track.dataset.currentIndex = track.dataset.currentIndex || '0';

      timers[carouselId] = setInterval(function() {
        var current = parseInt(track.dataset.currentIndex || '0', 10);
        var next = (current + 1) % total;
        window.propCarouselGoTo(carouselId, next, total);
      }, 3000);

      // Pause on hover
      container.addEventListener('mouseenter', function() {
        if (timers[carouselId]) {
          clearInterval(timers[carouselId]);
          timers[carouselId] = null;
        }
      });

      // Resume on mouse leave
      container.addEventListener('mouseleave', function() {
        if (!timers[carouselId]) {
          timers[carouselId] = setInterval(function() {
            var current = parseInt(track.dataset.currentIndex || '0', 10);
            var next = (current + 1) % total;
            window.propCarouselGoTo(carouselId, next, total);
          }, 3000);
        }
      });
    }

    // Initialize all carousels on page load
    function initCarousels() {
      var containers = document.querySelectorAll('[data-carousel]');
      containers.forEach(function(container) {
        var carouselId = container.getAttribute('data-carousel');
        if (carouselId && !timers[carouselId]) {
          startAutoSlide(container, carouselId);
        }
      });
    }

    // Support both Turbo and standard page loads
    if (typeof Turbo !== 'undefined') {
      document.addEventListener('turbo:load', initCarousels);
    }
    document.addEventListener('DOMContentLoaded', initCarousels);

    // Fallback: also run immediately if DOM is already loaded
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initCarousels, 100);
    }
  })();
</script>
