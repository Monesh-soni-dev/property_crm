<%
  pct   = @construction.overall_progress
  days  = @construction.days_remaining
%>

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
  <%= link_to "Construction Tracker", home_constructions_path, class: "hover:text-orange-500 transition" %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
  <span class="text-gray-800 font-medium"><%= @construction.name %></span>
</nav>

<div>

    <!-- Hero Card -->
    <div class="bg-gradient-to-br from-[#1a2e4a] to-[#1e3a5f] rounded-2xl text-white p-6 mb-8">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <!-- Left: Info -->
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <h1 class="text-2xl font-bold font-['Playfair_Display']"><%= @construction.name %></h1>
            <span class="text-xs px-2.5 py-1 rounded-full font-semibold
              <%= @construction.status == 'completed'  ? 'bg-green-500 text-white' :
                  @construction.status == 'in_progress' ? 'bg-blue-500 text-white' :
                  @construction.status == 'on_hold'     ? 'bg-amber-500 text-white' :
                                                          'bg-gray-500 text-white' %>">
              <%= @construction.status&.humanize || 'Planning' %>
            </span>
          </div>

          <% if @construction.address.present? || @construction.city.present? %>
            <p class="text-blue-200 text-sm">📍 <%= [@construction.address, @construction.city].compact.join(', ') %></p>
          <% end %>
          <% if @construction.site_manager.present? %>
            <p class="text-blue-300 text-sm mt-1">👷 Site Engineer: <strong class="text-white"><%= @construction.site_manager %></strong>
              <% if @construction.site_manager_phone.present? %>
                · <a href="tel:<%= @construction.site_manager_phone %>" class="text-blue-200 hover:text-white inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  <%= @construction.site_manager_phone %>
                </a>
              <% end %>
            </p>
          <% end %>
          <% if @construction.client_name.present? %>
            <p class="text-blue-300 text-sm mt-1">👤 Client: <strong class="text-white"><%= @construction.client_name %></strong>
              <% if @construction.client_phone.present? %>
                · <a href="tel:<%= @construction.client_phone %>" class="text-blue-200 hover:text-white"><%= @construction.client_phone %></a>
              <% end %>
            </p>
          <% end %>
          <% if @construction.total_built_area.present? || @construction.number_of_floors.present? %>
            <p class="text-blue-300 text-sm mt-1">🏗 
              <% if @construction.total_built_area.present? %><strong class="text-white"><%= @construction.total_built_area.to_i %> sq ft</strong><% end %>
              <% if @construction.number_of_floors.present? %> · <strong class="text-white"><%= @construction.number_of_floors %> floor(s)</strong><% end %>
            </p>
          <% end %>

          <!-- Timeline dates -->
          <div class="flex gap-6 mt-4 text-sm">
            <div>
              <p class="text-blue-400 text-xs uppercase tracking-wide">Started</p>
              <p class="font-semibold mt-0.5"><%= @construction.start_date&.strftime("%d %b %Y") || '—' %></p>
            </div>
            <div>
              <p class="text-blue-400 text-xs uppercase tracking-wide">Target</p>
              <p class="font-semibold mt-0.5"><%= @construction.expected_completion&.strftime("%d %b %Y") || '—' %></p>
            </div>
            <% if days %>
              <div>
                <p class="text-blue-400 text-xs uppercase tracking-wide">Days Left</p>
                <p class="font-semibold mt-0.5 <%= days < 0 ? 'text-red-300' : days <= 30 ? 'text-amber-300' : 'text-green-300' %>">
                  <%= days < 0 ? "#{days.abs} overdue" : "#{days} days" %>
                </p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Right: Progress circle + buttons -->
        <div class="flex flex-col items-center gap-4 flex-shrink-0">
          <!-- Progress Circle -->
          <div class="relative w-28 h-28">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="40" stroke="rgba(255,255,255,0.15)" stroke-width="10" fill="none"/>
              <circle cx="50" cy="50" r="40"
                      stroke="<%= pct >= 80 ? '#4ade80' : pct >= 50 ? '#60a5fa' : pct >= 25 ? '#fbbf24' : '#fb923c' %>"
                      stroke-width="10" fill="none"
                      stroke-dasharray="<%= (pct / 100.0 * 251.2).round(1) %> 251.2"
                      stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-2xl font-bold"><%= pct %>%</span>
              <span class="text-xs text-blue-200">complete</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex gap-2">
            <%= link_to edit_home_construction_path(@construction), class: "inline-flex items-center gap-1.5 bg-white text-gray-700 hover:bg-gray-100 text-xs font-medium px-3 py-2 rounded-lg transition" do %>
              <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
              Edit
            <% end %>
            <%= button_to home_construction_path(@construction), method: :delete,
                data: { confirm: "Delete '#{@construction.name}'? This cannot be undone." },
                form_class: "inline-flex",
                class: "inline-flex items-center gap-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-medium px-3 py-2 rounded-lg transition cursor-pointer border-0" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              Delete
            <% end %>
          </div>

          <% if @construction.on_schedule? %>
            <span class="bg-green-500 text-white text-xs px-3 py-1 rounded-full font-medium">✅ On Schedule</span>
          <% else %>
            <span class="bg-amber-500 text-white text-xs px-3 py-1 rounded-full font-medium">⚠ Behind Schedule</span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Customer Share Link -->
    <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 mb-8 flex flex-col sm:flex-row sm:items-center gap-3">
      <div class="flex items-center gap-3 flex-1 min-w-0">
        <div class="w-9 h-9 bg-orange-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-semibold text-orange-800">Customer Tracker Link</p>
          <p class="text-xs text-orange-600 mt-0.5 truncate" id="share-url">
            <%= request.base_url %><%= public_construction_tracker_path(share_token: @construction.share_token) %>
          </p>
        </div>
      </div>
      <div class="flex gap-2 flex-shrink-0">
        <button onclick="navigator.clipboard.writeText(document.getElementById('share-url').textContent.trim()).then(() => { this.textContent = '✓ Copied!'; this.classList.add('bg-green-500'); setTimeout(() => { this.textContent = 'Copy Link'; this.classList.remove('bg-green-500'); }, 2000); })"
                class="text-xs bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg transition font-medium">
          Copy Link
        </button>
        <%= link_to public_construction_tracker_path(share_token: @construction.share_token), target: "_blank",
            class: "text-xs bg-white border border-orange-300 text-orange-600 hover:bg-orange-50 px-4 py-2 rounded-lg transition font-medium" do %>
          Preview
        <% end %>
      </div>
    </div>

    <!-- Construction Phases Timeline -->
    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Building Phases Timeline</h2>
        <p class="text-sm text-gray-400 mt-0.5">Click any phase to update its progress</p>
      </div>
      <%= link_to new_home_construction_construction_phase_path(@construction), class: "flex items-center gap-2 text-sm text-orange-600 border border-orange-200 bg-orange-50 hover:bg-orange-100 px-4 py-2 rounded-xl transition font-medium" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Phase
      <% end %>
    </div>

    <% if @phases.empty? %>
      <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-gray-200">
        <svg class="w-12 h-12 text-gray-200 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <p class="text-gray-400 text-sm">No phases yet.</p>
      </div>
    <% else %>
      <!-- Phase overview bar (visual) -->
      <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
        <p class="text-xs text-gray-500 mb-2 font-medium">Phase Overview</p>
        <div class="flex gap-0.5 rounded-full overflow-hidden h-3">
          <% @phases.each do |ph| %>
            <div class="flex-1 tooltip
              <%= ph.status == 'completed' ? 'bg-green-500' : ph.status == 'in_progress' ? 'bg-blue-500' : 'bg-gray-200' %>"
                 title="<%= ph.name %> — <%= ph.status&.humanize %>"></div>
          <% end %>
        </div>
        <div class="flex gap-4 mt-2 text-xs text-gray-400">
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-green-500 rounded-full"></span>Completed (<%= @phases.count { |p| p.status == 'completed' } %>)</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-blue-500 rounded-full animate-pulse"></span>In Progress (<%= @phases.count { |p| p.status == 'in_progress' } %>)</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-gray-200 rounded-full"></span>Pending (<%= @phases.count { |p| p.status == 'pending' } %>)</span>
        </div>
      </div>

      <!-- Phase List -->
      <div class="space-y-3">
        <% @phases.each_with_index do |phase, idx| %>
          <%
            is_done   = phase.status == 'completed'
            is_active = phase.status == 'in_progress'
            is_hold   = phase.status == 'on_hold'
            pct_p     = phase.completion_pct.to_i
            bar_color = is_done ? 'bg-green-500' : is_active ? 'bg-blue-500' : is_hold ? 'bg-amber-400' : 'bg-gray-200'
            border_c  = is_done ? 'border-green-200' : is_active ? 'border-blue-300' : is_hold ? 'border-amber-200' : 'border-gray-200'
          %>
          <div class="bg-white rounded-2xl border <%= border_c %> p-4 hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4">
              <!-- Phase Number -->
              <div class="w-10 h-10 rounded-xl flex-shrink-0 flex items-center justify-center font-bold text-sm shadow-sm
                <%= is_done ? 'bg-green-500 text-white' : is_active ? 'bg-blue-500 text-white' : is_hold ? 'bg-amber-400 text-white' : 'bg-gray-100 text-gray-400' %>">
                <% if is_done %>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <% elsif is_active %>
                  <div class="w-3 h-3 bg-white rounded-full animate-pulse"></div>
                <% else %>
                  <%= idx + 1 %>
                <% end %>
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                  <div>
                    <h4 class="font-semibold text-gray-900"><%= phase.name %></h4>
                    <% if phase.description.present? %>
                      <p class="text-xs text-gray-400 mt-0.5"><%= phase.description %></p>
                    <% end %>
                  </div>
                  <div class="flex items-center gap-2 flex-shrink-0">
                    <span class="text-xs px-2 py-0.5 rounded-full
                      <%= is_done ? 'bg-green-100 text-green-700' : is_active ? 'bg-blue-100 text-blue-700' : is_hold ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-500' %>">
                      <%= phase.status&.humanize || 'Pending' %>
                    </span>
                    <%= link_to edit_home_construction_construction_phase_path(@construction, phase), class: "text-gray-400 hover:text-orange-500 transition" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    <% end %>
                    <%= button_to home_construction_construction_phase_path(@construction, phase), method: :delete,
                        data: { confirm: "Remove phase '#{phase.name}'?" },
                        form_class: "inline-flex",
                        class: "inline-flex items-center justify-center text-gray-400 hover:text-red-500 transition cursor-pointer border-0 bg-transparent p-1 rounded" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    <% end %>
                  </div>
                </div>

                <!-- Progress -->
                <div class="mt-2.5">
                  <div class="flex justify-between text-xs text-gray-400 mb-1">
                    <span>Progress</span>
                    <span class="font-bold text-gray-700"><%= pct_p %>%</span>
                  </div>
                  <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                    <div class="h-full <%= bar_color %> rounded-full transition-all duration-500"
                         style="width:<%= pct_p %>%"></div>
                  </div>
                </div>

                <!-- Dates Row -->
                <div class="mt-2 flex flex-wrap gap-4 text-xs text-gray-400">
                  <% if phase.planned_start %>
                    <span>📅 Plan: <%= phase.planned_start.strftime("%d %b") %> → <%= phase.planned_end&.strftime("%d %b %Y") || '?' %></span>
                  <% end %>
                  <% if phase.actual_start %>
                    <span class="text-blue-500">🔨 Started: <%= phase.actual_start.strftime("%d %b %Y") %></span>
                  <% end %>
                  <% if phase.actual_end %>
                    <span class="text-green-600">✅ Done: <%= phase.actual_end.strftime("%d %b %Y") %></span>
                  <% end %>
                  <% if phase.notes.present? %>
                    <span class="text-gray-500">· <%= phase.notes.truncate(50) %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

</div>
