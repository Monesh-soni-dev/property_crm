<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 font-['Playfair_Display'] flex items-center gap-2">
      <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      Construction Tracker
    </h1>
    <p class="text-sm text-gray-500 mt-0.5">Track every home build — phase by phase. Share live progress with your customers.</p>
  </div>
  <%= link_to new_home_construction_path, class: "inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    New Construction
  <% end %>
</div>

<div class="mt-8">

    <% if @constructions.empty? %>
      <!-- Empty State -->
      <div class="text-center py-24 bg-white rounded-2xl border border-dashed border-gray-300">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-orange-50 rounded-2xl mb-5">
          <svg class="w-10 h-10 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-700 mb-2">No construction jobs yet</h3>
        <p class="text-gray-400 text-sm mb-6 max-w-xs mx-auto">Add your first home construction to start tracking phases and sharing progress with your customer.</p>
        <%= link_to new_home_construction_path, class: "bg-orange-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-orange-600 transition" do %>
          + Start Tracking a Construction
        <% end %>
      </div>

    <% else %>
      <!-- Summary Stats -->
      <% total   = @constructions.count
         active  = @constructions.count { |c| c.status == 'in_progress' }
         done    = @constructions.count { |c| c.status == 'completed' }
         avg_pct = @constructions.any? ? (@constructions.sum(&:overall_progress) / @constructions.count.to_f).round : 0 %>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
          <p class="text-3xl font-bold text-gray-800"><%= total %></p>
          <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Total Jobs</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
          <p class="text-3xl font-bold text-blue-600"><%= active %></p>
          <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">In Progress</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
          <p class="text-3xl font-bold text-green-600"><%= done %></p>
          <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Completed</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
          <p class="text-3xl font-bold text-orange-500"><%= avg_pct %>%</p>
          <p class="text-xs text-gray-400 mt-1 uppercase tracking-wide">Avg Progress</p>
        </div>
      </div>

      <!-- Construction Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <% @constructions.each do |c| %>
          <% pct  = c.overall_progress
             days = c.days_remaining
             cur  = c.current_phase %>

          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">

            <!-- Color-coded top strip based on status -->
            <div class="h-1.5 w-full <%= c.status == 'completed' ? 'bg-green-500' : c.status == 'in_progress' ? 'bg-blue-500' : c.status == 'on_hold' ? 'bg-amber-500' : 'bg-gray-300' %>"></div>

            <div class="p-5 flex-1 flex flex-col">
              <!-- Title Row -->
              <div class="flex items-start justify-between gap-2 mb-3">
                <div>
                  <h3 class="font-bold text-gray-900 text-base leading-tight"><%= c.name %></h3>
                  <% if c.client_name.present? %>
                    <p class="text-xs text-gray-500 mt-0.5 flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      Client: <%= c.client_name %>
                    </p>
                  <% end %>
                  <% if c.address.present? || c.city.present? %>
                    <p class="text-xs text-gray-400 mt-0.5 flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                      <%= [c.address, c.city].compact.join(', ') %>
                    </p>
                  <% end %>
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full flex-shrink-0
                  <%= c.status == 'completed'  ? 'bg-green-100 text-green-700' :
                      c.status == 'in_progress' ? 'bg-blue-100 text-blue-700' :
                      c.status == 'on_hold'     ? 'bg-amber-100 text-amber-700' :
                                                  'bg-gray-100 text-gray-500' %>">
                  <%= c.status&.humanize || 'Planning' %>
                </span>
              </div>

              <!-- Progress Bar -->
              <div class="mb-3">
                <div class="flex justify-between text-xs text-gray-400 mb-1">
                  <span>Overall Progress</span>
                  <span class="font-bold text-gray-700"><%= pct %>%</span>
                </div>
                <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500
                    <%= pct >= 80 ? 'bg-green-500' : pct >= 50 ? 'bg-blue-500' : pct >= 25 ? 'bg-amber-500' : 'bg-orange-400' %>"
                       style="width:<%= pct %>%"></div>
                </div>
              </div>

              <!-- Current Phase -->
              <% if cur %>
                <div class="flex items-center gap-2 text-xs text-blue-700 bg-blue-50 rounded-lg px-3 py-2 mb-3">
                  <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse flex-shrink-0"></div>
                  <span>Currently: <strong><%= cur.name %></strong></span>
                </div>
              <% end %>

              <!-- Dates + Days -->
              <div class="grid grid-cols-2 gap-2 text-xs text-gray-500 mb-4">
                <div>
                  <p class="text-gray-400 uppercase tracking-wide text-[10px]">Started</p>
                  <p class="font-medium text-gray-700 mt-0.5"><%= c.start_date&.strftime("%d %b %Y") || '—' %></p>
                </div>
                <div>
                  <p class="text-gray-400 uppercase tracking-wide text-[10px]">Target</p>
                  <p class="font-medium text-gray-700 mt-0.5"><%= c.expected_completion&.strftime("%d %b %Y") || '—' %></p>
                </div>
              </div>

              <% if days %>
                <div class="text-xs mb-4
                  <%= days < 0 ? 'text-red-600' : days <= 30 ? 'text-amber-600' : 'text-green-600' %>">
                  <%= days < 0 ? "⚠ #{days.abs} days overdue" : days == 0 ? "🎉 Due today!" : "✅ #{days} days remaining" %>
                </div>
              <% end %>

              <!-- Phase count -->
              <p class="text-xs text-gray-400 mt-auto mb-4">
                <%= c.construction_phases.count { |p| p.status == 'completed' } %> / <%= c.construction_phases.count %> phases completed
              </p>

              <!-- Action Buttons -->
              <div class="flex gap-2 mt-auto">
                <%= link_to home_construction_path(c), class: "flex-1 text-center bg-orange-500 text-white text-sm py-2.5 rounded-xl hover:bg-orange-600 transition font-medium" do %>
                  View Details
                <% end %>
                <%= link_to public_construction_tracker_path(share_token: c.share_token), target: "_blank", class: "flex items-center gap-1 text-sm text-orange-600 border border-orange-200 px-3 py-2.5 rounded-xl hover:bg-orange-50 transition", title: "Open customer view" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                  </svg>
                  Share
                <% end %>
                <%= link_to edit_home_construction_path(c), class: "flex items-center text-sm text-gray-500 border border-gray-200 px-3 py-2.5 rounded-xl hover:bg-gray-50 transition" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
</div>
