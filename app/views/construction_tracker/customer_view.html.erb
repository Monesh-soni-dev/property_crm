<%
  pct     = @site.computed_progress
  days    = @site.days_remaining
  project = @site.project
  phases  = @phases
  completed_phases = phases.count { |p| p[:status] == 'completed' }
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Construction Progress — <%= project.name %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all" %>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 font-['Inter']">

<!-- Hero Banner -->
<div class="bg-gradient-to-br from-[#0f1f35] via-[#1a2e4a] to-[#1e3a5f] text-white">
  <div class="max-w-3xl mx-auto px-4 py-10 text-center">
    <!-- Logo / Brand -->
    <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-2 text-sm mb-6">
      <svg class="w-4 h-4 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      <span class="text-blue-200">PlotPlans · Live Construction Tracker</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold font-['Playfair_Display'] mb-2">Your Home is Being Built!</h1>
    <h2 class="text-xl text-blue-200 font-semibold mb-1"><%= project.name %></h2>
    <% if @site.address.present? %>
      <p class="text-blue-300 text-sm"><%= @site.address %></p>
    <% end %>

    <!-- Big Progress Ring -->
    <div class="mt-8 flex flex-col items-center">
      <div class="relative w-40 h-40">
        <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="42" stroke="rgba(255,255,255,0.1)" stroke-width="8" fill="none"/>
          <circle cx="50" cy="50" r="42"
                  stroke="<%= pct >= 80 ? '#4ade80' : pct >= 50 ? '#60a5fa' : pct >= 25 ? '#fbbf24' : '#f87171' %>"
                  stroke-width="8" fill="none"
                  stroke-dasharray="<%= (pct / 100.0 * 263.9).round(1) %> 263.9"
                  stroke-linecap="round"/>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-4xl font-bold"><%= pct %>%</span>
          <span class="text-blue-200 text-sm">Complete</span>
        </div>
      </div>

      <!-- Status Pills -->
      <div class="flex flex-wrap justify-center gap-3 mt-6 text-sm">
        <span class="bg-white/10 rounded-full px-4 py-1.5">
          🏗️ <strong><%= completed_phases %></strong> / <%= phases.count %> phases done
        </span>
        <% if days %>
          <span class="<%= days < 0 ? 'bg-red-500/30' : days <= 30 ? 'bg-amber-500/30' : 'bg-green-500/30' %> rounded-full px-4 py-1.5">
            <%= days < 0 ? "⚠️ #{days.abs} days overdue" : days == 0 ? "🎉 Due today!" : "📅 #{days} days to go" %>
          </span>
        <% end %>
        <% unless @site.on_schedule? %>
          <span class="bg-orange-500/20 text-orange-200 rounded-full px-4 py-1.5">
            ⏱ We're working to catch up
          </span>
        <% end %>
      </div>
    </div>

    <!-- Timeline Dates -->
    <div class="mt-6 flex justify-center gap-8 text-sm">
      <div class="text-center">
        <p class="text-blue-300 text-xs uppercase tracking-wide">Work Started</p>
        <p class="font-semibold mt-1"><%= @site.start_date&.strftime("%d %b %Y") || 'TBD' %></p>
      </div>
      <div class="w-px bg-white/20"></div>
      <div class="text-center">
        <p class="text-blue-300 text-xs uppercase tracking-wide">Expected Handover</p>
        <p class="font-semibold mt-1"><%= @site.expected_completion&.strftime("%d %b %Y") || 'TBD' %></p>
      </div>
    </div>
  </div>
</div>

<div class="max-w-3xl mx-auto px-4 py-8">

  <% if @site.customer_notes.present? %>
    <!-- Builder Message to Customer -->
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 mb-8">
      <div class="flex gap-3">
        <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-blue-800 mb-1">Message from your builder</p>
          <p class="text-blue-700 text-sm leading-relaxed"><%= @site.customer_notes %></p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Phase Visual Progress Bar (compact overview) -->
  <div class="bg-white rounded-2xl border border-gray-200 p-5 mb-8">
    <h3 class="font-semibold text-gray-800 mb-4">Construction Phases Overview</h3>
    <div class="flex gap-1 rounded-full overflow-hidden h-4 mb-3">
      <% if phases.any? %>
        <% phases.each do |phase| %>
          <%
            seg_color = case phase[:status]
                        when 'completed' then 'bg-green-500'
                        when 'in_progress' then 'bg-blue-500'
                        else 'bg-gray-200'
                        end
          %>
          <div class="flex-1 <%= seg_color %>" title="<%= phase[:title] %>"></div>
        <% end %>
      <% else %>
        <div class="flex-1 bg-gray-100 rounded-full"></div>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-3 text-xs text-gray-500">
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-green-500 rounded-full inline-block"></span>Completed</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-blue-500 rounded-full inline-block"></span>In Progress</span>
      <span class="flex items-center gap-1"><span class="w-3 h-3 bg-gray-200 rounded-full inline-block"></span>Upcoming</span>
    </div>
  </div>

  <!-- Detailed Timeline -->
  <h3 class="text-lg font-bold text-gray-900 mb-5">Detailed Construction Timeline</h3>

  <% if phases.empty? %>
    <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-gray-200">
      <p class="text-gray-400">Timeline updates will appear here soon.</p>
    </div>
  <% else %>
    <div class="relative">
      <!-- Vertical connector line -->
      <div class="absolute left-5 top-6 bottom-6 w-0.5 bg-gradient-to-b from-blue-400 to-gray-200"></div>

      <div class="space-y-5">
        <% phases.each_with_index do |phase, idx| %>
          <%
            is_done       = phase[:status] == 'completed'
            is_active     = phase[:status] == 'in_progress'
            card_border   = is_done ? 'border-green-200 bg-green-50/30' : is_active ? 'border-blue-300 bg-blue-50/30' : 'border-gray-200'
            dot_bg        = is_done ? 'bg-green-500' : is_active ? 'bg-blue-500' : 'bg-gray-300'
          %>
          <div class="flex gap-4">
            <!-- Dot -->
            <div class="flex-shrink-0 flex flex-col items-center z-10">
              <div class="w-10 h-10 rounded-full <%= dot_bg %> flex items-center justify-center shadow-md">
                <% if is_done %>
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <% elsif is_active %>
                  <div class="w-3 h-3 bg-white rounded-full animate-pulse"></div>
                <% else %>
                  <span class="text-white font-bold text-sm"><%= idx + 1 %></span>
                <% end %>
              </div>
            </div>

            <!-- Card -->
            <div class="flex-1 bg-white rounded-2xl border <%= card_border %> p-5 shadow-sm">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <h4 class="font-semibold text-gray-900 text-base"><%= phase[:title] %></h4>
                  <% if phase[:description].present? %>
                    <p class="text-sm text-gray-500 mt-1 leading-relaxed"><%= phase[:description] %></p>
                  <% end %>
                </div>
                <% if is_done %>
                  <span class="bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">✓ Done</span>
                <% elsif is_active %>
                  <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap animate-pulse">● In Progress</span>
                <% else %>
                  <span class="bg-gray-100 text-gray-500 text-xs px-2.5 py-1 rounded-full whitespace-nowrap">Upcoming</span>
                <% end %>
              </div>

              <!-- Progress Bar -->
              <div class="mt-3">
                <div class="flex items-center justify-between text-xs text-gray-400 mb-1.5">
                  <span>Progress</span>
                  <span class="font-semibold text-gray-700"><%= phase[:pct] %>%</span>
                </div>
                <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-700
                    <%= is_done ? 'bg-green-500' : is_active ? 'bg-blue-500' : 'bg-gray-300' %>"
                       style="width:<%= phase[:pct] %>%"></div>
                </div>
              </div>

              <!-- Dates Row -->
              <div class="mt-3 flex flex-wrap gap-4 text-xs text-gray-500">
                <% if phase[:planned] %>
                  <span>📅 Planned: <strong class="text-gray-700"><%= phase[:planned].strftime("%d %b %Y") %></strong></span>
                <% end %>
                <% if phase[:actual] %>
                  <span>✅ Completed: <strong class="text-green-700"><%= phase[:actual].strftime("%d %b %Y") %></strong></span>
                <% end %>
                <% if phase[:docs] > 0 %>
                  <span>📷 <%= phase[:docs] %> photos</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Footer -->
  <div class="text-center mt-12 py-6 border-t border-gray-200">
    <p class="text-gray-400 text-sm">Powered by <strong class="text-[#1a2e4a]">PlotPlans</strong></p>
    <p class="text-gray-400 text-xs mt-1">This tracker is updated in real-time by your builder.</p>
  </div>
</div>

</body>
</html>
