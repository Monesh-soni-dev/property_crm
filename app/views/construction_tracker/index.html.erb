<div class="min-h-screen bg-gray-50">
  <!-- Page Header -->
  <div class="bg-white border-b border-gray-200 px-4 py-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 font-['Playfair_Display']">Construction Tracker</h1>
          <p class="text-sm text-gray-500 mt-1">Monitor all your active home construction sites in one place</p>
        </div>
        <%= link_to projects_path, class: "inline-flex items-center gap-2 bg-[#1a2e4a] text-white text-sm px-5 py-2.5 rounded-xl hover:bg-[#2a4a72] transition font-medium" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add New Project / Site
        <% end %>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">

    <% if @sites.empty? %>
      <!-- Empty State -->
      <div class="text-center py-20">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-2xl mb-6">
          <svg class="w-10 h-10 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-700 mb-2">No construction sites yet</h3>
        <p class="text-gray-500 mb-6 max-w-sm mx-auto">Create a project and add a construction site to start tracking your home builds.</p>
        <%= link_to new_project_path, class: "bg-blue-600 text-white px-6 py-3 rounded-xl font-medium hover:bg-blue-700 transition" do %>
          Create Your First Project
        <% end %>
      </div>

    <% else %>
      <!-- Summary Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <p class="text-3xl font-bold text-[#1a2e4a]"><%= @sites.count %></p>
          <p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">Total Sites</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <p class="text-3xl font-bold text-green-600"><%= @sites.count { |s| s.status == 'completed' } %></p>
          <p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">Completed</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <p class="text-3xl font-bold text-blue-600"><%= @sites.count { |s| s.status != 'completed' && s.status.present? } %></p>
          <p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">Active</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
          <% avg = @sites.any? ? (@sites.sum { |s| s.computed_progress } / @sites.count.to_f).round : 0 %>
          <p class="text-3xl font-bold text-amber-600"><%= avg %>%</p>
          <p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">Avg Progress</p>
        </div>
      </div>

      <!-- Sites Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <% @sites.each do |site| %>
          <% project = site.project %>
          <% pct = site.computed_progress %>
          <% days = site.days_remaining %>

          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <!-- Site Header -->
            <div class="bg-gradient-to-br from-[#1a2e4a] to-[#2a4a72] p-5 text-white">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="font-bold text-lg leading-tight"><%= project.name %></h3>
                  <p class="text-blue-200 text-sm mt-1"><%= site.site_manager.presence || 'No manager assigned' %></p>
                </div>
                <span class="text-xs px-2.5 py-1 rounded-full font-medium
                  <%= site.status == 'completed'  ? 'bg-green-400/20 text-green-200' :
                      site.status == 'in_progress' ? 'bg-blue-400/20 text-blue-200' :
                                                     'bg-gray-400/20 text-gray-200' %>">
                  <%= site.status&.humanize || 'Planning' %>
                </span>
              </div>

              <!-- Progress Ring / Bar -->
              <div class="mt-4">
                <div class="flex items-center justify-between text-sm mb-1.5">
                  <span class="text-blue-200">Overall Progress</span>
                  <span class="font-bold text-white text-base"><%= pct %>%</span>
                </div>
                <div class="h-2 bg-white/20 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-700
                    <%= pct >= 80 ? 'bg-green-400' : pct >= 50 ? 'bg-blue-400' : pct >= 25 ? 'bg-amber-400' : 'bg-red-400' %>"
                       style="width:<%= pct %>%"></div>
                </div>
              </div>
            </div>

            <!-- Site Details -->
            <div class="p-5">
              <!-- Timeline Dates -->
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wide">Started</p>
                  <p class="text-sm font-semibold text-gray-700 mt-0.5">
                    <%= site.start_date&.strftime("%d %b %Y") || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wide">Target Completion</p>
                  <p class="text-sm font-semibold text-gray-700 mt-0.5">
                    <%= site.expected_completion&.strftime("%d %b %Y") || '—' %>
                  </p>
                </div>
              </div>

              <!-- Days Remaining Badge -->
              <% if days %>
                <div class="flex items-center gap-2 mb-4">
                  <% if days < 0 %>
                    <span class="inline-flex items-center gap-1.5 text-xs bg-red-50 text-red-700 px-3 py-1.5 rounded-full font-medium">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                      <%= days.abs %> days overdue
                    </span>
                  <% elsif days <= 30 %>
                    <span class="inline-flex items-center gap-1.5 text-xs bg-amber-50 text-amber-700 px-3 py-1.5 rounded-full font-medium">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path></svg>
                      <%= days %> days left
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 text-xs bg-green-50 text-green-700 px-3 py-1.5 rounded-full font-medium">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                      <%= days %> days remaining
                    </span>
                  <% end %>

                  <% unless site.on_schedule? %>
                    <span class="text-xs text-orange-500 font-medium">⚠ Behind schedule</span>
                  <% end %>
                </div>
              <% end %>

              <!-- Milestone Summary -->
              <div class="flex items-center gap-4 text-xs text-gray-500 mb-5 border-t border-gray-100 pt-4">
                <span><strong class="text-gray-800"><%= site.milestones.count %></strong> milestones</span>
                <span><strong class="text-gray-800"><%= site.milestones.where(status: 'completed').count %></strong> done</span>
                <span><strong class="text-gray-800"><%= site.workers.count %></strong> workers</span>
              </div>

              <!-- Actions -->
              <div class="flex gap-2">
                <%= link_to construction_tracker_path(site), class: "flex-1 text-center bg-[#1a2e4a] text-white text-sm py-2.5 rounded-xl hover:bg-[#2a4a72] transition font-medium" do %>
                  View Timeline
                <% end %>
                <%= link_to construction_tracker_customer_path(share_token: site.share_token), class: "flex items-center gap-1 text-sm text-blue-600 border border-blue-200 px-3 py-2.5 rounded-xl hover:bg-blue-50 transition", title: "Customer view link" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                  </svg>
                  Share
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
