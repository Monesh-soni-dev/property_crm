<%
  pct   = @site.computed_progress
  days  = @site.days_remaining
  project = @site.project
%>

<!-- Breadcrumb -->
<div class="bg-white border-b border-gray-200 px-4 py-3">
  <div class="max-w-7xl mx-auto flex items-center gap-2 text-sm text-gray-500">
    <%= link_to "Construction Tracker", construction_tracker_index_path, class: "hover:text-blue-600 transition" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-gray-800 font-medium"><%= project.name %></span>
  </div>
</div>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Site Summary Card -->
    <div class="bg-gradient-to-br from-[#1a2e4a] to-[#2a4a72] rounded-2xl p-6 mb-8 text-white">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="flex-1">
          <h1 class="text-2xl font-bold font-['Playfair_Display']"><%= project.name %></h1>
          <p class="text-blue-200 mt-1 text-sm"><%= @site.address.presence || project.location %></p>
          <p class="text-blue-300 text-sm mt-0.5">Site Manager: <strong class="text-white"><%= @site.site_manager.presence || '—' %></strong></p>
        </div>

        <!-- Big Progress Circle (CSS only) -->
        <div class="flex items-center gap-6">
          <div class="relative w-28 h-28 flex-shrink-0">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="40" stroke="rgba(255,255,255,0.15)" stroke-width="10" fill="none"/>
              <circle cx="50" cy="50" r="40"
                      stroke="<%= pct >= 80 ? '#4ade80' : pct >= 50 ? '#60a5fa' : pct >= 25 ? '#fbbf24' : '#f87171' %>"
                      stroke-width="10" fill="none"
                      stroke-dasharray="<%= (pct / 100.0 * 251.2).round(1) %> 251.2"
                      stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-2xl font-bold"><%= pct %>%</span>
              <span class="text-xs text-blue-200">done</span>
            </div>
          </div>

          <!-- Key Stats -->
          <div class="grid grid-cols-2 gap-3 text-center">
            <div class="bg-white/10 rounded-xl px-4 py-3">
              <p class="text-xl font-bold"><%= @phases.count %></p>
              <p class="text-xs text-blue-200 mt-0.5">Milestones</p>
            </div>
            <div class="bg-white/10 rounded-xl px-4 py-3">
              <p class="text-xl font-bold"><%= @phases.count { |p| p[:status] == 'completed' } %></p>
              <p class="text-xs text-blue-200 mt-0.5">Completed</p>
            </div>
            <div class="bg-white/10 rounded-xl px-4 py-3">
              <% if days %>
                <p class="text-xl font-bold <%= days < 0 ? 'text-red-300' : days <= 30 ? 'text-amber-300' : '' %>"><%= days.abs %></p>
                <p class="text-xs text-blue-200 mt-0.5"><%= days < 0 ? 'days over' : 'days left' %></p>
              <% else %>
                <p class="text-xl font-bold">—</p>
                <p class="text-xs text-blue-200 mt-0.5">days left</p>
              <% end %>
            </div>
            <div class="bg-white/10 rounded-xl px-4 py-3">
              <p class="text-xl font-bold"><%= @site.workers.count %></p>
              <p class="text-xs text-blue-200 mt-0.5">Workers</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Dates & Schedule Status -->
      <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-white/20 pt-4 text-sm">
        <span class="text-blue-200">
          Start: <strong class="text-white"><%= @site.start_date&.strftime("%d %b %Y") || '—' %></strong>
        </span>
        <span class="text-blue-200">→</span>
        <span class="text-blue-200">
          Target: <strong class="text-white"><%= @site.expected_completion&.strftime("%d %b %Y") || '—' %></strong>
        </span>
        <% if @site.on_schedule? %>
          <span class="ml-auto inline-flex items-center gap-1 bg-green-400/20 text-green-200 text-xs px-3 py-1 rounded-full">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            On Schedule
          </span>
        <% else %>
          <span class="ml-auto inline-flex items-center gap-1 bg-amber-400/20 text-amber-200 text-xs px-3 py-1 rounded-full">
            ⚠ Behind Schedule
          </span>
        <% end %>
      </div>
    </div>

    <!-- Share Link for Customer -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-8 flex flex-col sm:flex-row sm:items-center gap-3">
      <div class="flex-1">
        <p class="text-sm font-semibold text-blue-800">Customer Share Link</p>
        <p class="text-xs text-blue-600 mt-0.5">Send this link to your customer so they can track construction progress</p>
      </div>
      <div class="flex items-center gap-2">
        <code class="text-xs bg-white border border-blue-200 rounded-lg px-3 py-2 text-blue-700 font-mono">
          <%= request.base_url %><%= construction_tracker_customer_path(share_token: @site.share_token) %>
        </code>
        <button onclick="navigator.clipboard.writeText('<%= request.base_url %><%= construction_tracker_customer_path(share_token: @site.share_token) %>').then(() => { this.innerHTML = 'Copied!'; setTimeout(() => this.innerHTML = 'Copy', 2000); })"
                class="text-xs bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700 transition whitespace-nowrap">
          Copy
        </button>
      </div>
    </div>

    <!-- Construction Timeline -->
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold text-gray-900">Construction Timeline</h2>
      <%= link_to "Manage Milestones", project_construction_site_path(project), class: "text-sm text-blue-600 hover:underline" %>
    </div>

    <% if @phases.empty? %>
      <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-gray-300">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <p class="text-gray-500 text-sm">No milestones added yet.</p>
        <%= link_to "Add First Milestone", new_project_construction_site_milestone_path(project), class: "mt-3 inline-block text-blue-600 text-sm font-medium hover:underline" %>
      </div>
    <% else %>
      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden sm:block"></div>

        <div class="space-y-4">
          <% @phases.each_with_index do |phase, idx| %>
            <%
              dot_color = case phase[:status]
                          when 'completed'  then 'bg-green-500 ring-green-200'
                          when 'in_progress' then 'bg-blue-500 ring-blue-200'
                          else 'bg-gray-300 ring-gray-100'
                          end
              bar_color = case
                          when phase[:pct] >= 80 then 'bg-green-500'
                          when phase[:pct] >= 50 then 'bg-blue-500'
                          when phase[:pct] >= 25 then 'bg-amber-500'
                          else 'bg-gray-300'
                          end
            %>
            <div class="flex gap-4 sm:gap-6 relative">
              <!-- Timeline dot -->
              <div class="flex-shrink-0 flex flex-col items-center">
                <div class="w-12 h-12 rounded-full <%= dot_color %> ring-4 flex items-center justify-center text-white font-bold text-sm shadow z-10 bg-white">
                  <% if phase[:status] == 'completed' %>
                    <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  <% elsif phase[:status] == 'in_progress' %>
                    <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                  <% else %>
                    <span class="text-gray-400 text-xs font-bold"><%= idx + 1 %></span>
                  <% end %>
                </div>
              </div>

              <!-- Phase Card -->
              <div class="flex-1 bg-white rounded-2xl border border-gray-200 p-5 mb-2 hover:shadow-md transition-shadow">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-semibold text-gray-900"><%= phase[:title] %></h3>
                      <span class="text-xs px-2 py-0.5 rounded-full
                        <%= phase[:status] == 'completed' ? 'bg-green-100 text-green-700' :
                            phase[:status] == 'in_progress' ? 'bg-blue-100 text-blue-700' :
                                                               'bg-gray-100 text-gray-500' %>">
                        <%= phase[:status]&.humanize || 'Pending' %>
                      </span>
                    </div>
                    <% if phase[:description].present? %>
                      <p class="text-sm text-gray-500 mt-1"><%= phase[:description] %></p>
                    <% end %>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <p class="text-xs text-gray-400">Planned: <strong><%= phase[:planned]&.strftime("%d %b %Y") || '—' %></strong></p>
                    <% if phase[:actual] %>
                      <p class="text-xs text-green-600 mt-0.5">Done: <strong><%= phase[:actual].strftime("%d %b %Y") %></strong></p>
                    <% end %>
                  </div>
                </div>

                <!-- Progress Bar -->
                <div class="mt-3">
                  <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                    <span><%= phase[:tasks_done] %> / <%= phase[:tasks_total] %> tasks completed</span>
                    <span class="font-semibold text-gray-700"><%= phase[:pct] %>%</span>
                  </div>
                  <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                    <div class="h-full <%= bar_color %> rounded-full transition-all duration-500"
                         style="width:<%= phase[:pct] %>%"></div>
                  </div>
                </div>

                <!-- Docs count -->
                <% if phase[:docs] > 0 %>
                  <p class="text-xs text-gray-400 mt-2">
                    <svg class="w-3.5 h-3.5 inline -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <%= phase[:docs] %> photos/documents attached
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
