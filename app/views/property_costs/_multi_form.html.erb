<%= form_with url: property_costs_path, local: true, multipart: true, class: "space-y-6" do %>
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex items-center justify-between gap-4 mb-4">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Link Costs to Property / Project</h2>
        <p class="text-sm text-gray-500">Choose a property or project once, then add multiple cost rows below.</p>
      </div>
      <div class="text-xs text-gray-400">You can add or remove rows before submitting.</div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Property</label>
        <select name="property_id" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">— No Property —</option>
          <% @properties.each do |property| %>
            <option value="<%= property.id %>" <%= 'selected' if property.id.to_s == @property_id.to_s %>><%= "#{property.project.name} — #{property.title} (#{property.unit_number})" %></option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Project</label>
        <select name="project_id" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">— No Project —</option>
          <% @projects.each do |project| %>
            <option value="<%= project.id %>" <%= 'selected' if project.id.to_s == @project_id.to_s %>><%= project.name %></option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <div id="cost-rows" class="space-y-6">
    <% @cost_rows.each_with_index do |cost, idx| %>
      <%= render partial: 'property_costs/multi_cost_row', locals: { cost: cost, index: idx } %>
    <% end %>
  </div>

  <template id="cost-row-template">
    <%= render partial: 'property_costs/multi_cost_row', locals: { cost: PropertyCost.new(cost_date: Date.today), index: 'TEMPLATE' } %>
  </template>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <button type="button" id="add-cost-row" class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">Add another cost</button>
    <%= submit_tag "Create Cost Entries", class: "inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('cost-rows');
    const template = document.getElementById('cost-row-template');
    const addButton = document.getElementById('add-cost-row');

    function updateRowTitles() {
      container.querySelectorAll('.cost-row').forEach(function(row, idx) {
        const title = row.querySelector('.cost-row-number');
        if (title) title.textContent = 'Cost item ' + (idx + 1);
      });
      container.querySelectorAll('.remove-cost-row').forEach(function(button) {
        button.disabled = container.querySelectorAll('.cost-row').length <= 1;
      });
    }

    addButton.addEventListener('click', function() {
      const clone = template.content.firstElementChild.cloneNode(true);
      clone.classList.remove('hidden');
      clone.querySelectorAll('input, select, textarea').forEach(function(field) {
        if (field.tagName === 'TEXTAREA') {
          field.value = '';
        } else if (field.type !== 'hidden' && field.type !== 'file') {
          field.value = '';
        }
      });
      container.appendChild(clone);
      updateRowTitles();
    });

    container.addEventListener('click', function(event) {
      const button = event.target.closest('.remove-cost-row');
      if (!button) return;
      const row = button.closest('.cost-row');
      if (row && container.querySelectorAll('.cost-row').length > 1) {
        row.remove();
        updateRowTitles();
      }
    });

    updateRowTitles();
  });
</script>
