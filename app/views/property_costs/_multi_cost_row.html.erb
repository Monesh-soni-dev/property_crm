<div class="bg-white rounded-xl border border-gray-200 p-6 cost-row">
  <div class="flex items-center justify-between mb-4 gap-4">
    <h3 class="text-sm font-semibold text-slate-900 cost-row-number">Cost item <%= index.is_a?(Integer) ? index + 1 : 'New' %></h3>
    <button type="button" class="remove-cost-row inline-flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 transition-colors">
      Remove
    </button>
  </div>

  <% if cost.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% cost.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= fields_for "property_costs[]", cost do |cf| %>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <div class="xl:col-span-2">
        <%= cf.label :title, class: "block text-xs font-semibold text-gray-700 mb-1" do %>
          Cost Title <span class="text-red-500">*</span>
        <% end %>
        <%= cf.text_field :title,
            placeholder: "e.g. RCC Slab Work, Plot Registration, Brokerage...",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= cf.label :category, class: "block text-xs font-semibold text-gray-700 mb-1" do %>
          Category <span class="text-red-500">*</span>
        <% end %>
        <%= cf.select :category,
            options_for_select(PropertyCost::CATEGORIES.map { |c| [c.humanize, c] }, cf.object.category),
            {},
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= cf.label :amount, class: "block text-xs font-semibold text-gray-700 mb-1" do %>
          Amount (₹) <span class="text-red-500">*</span>
        <% end %>
        <%= cf.number_field :amount, min: 1, step: 1,
            placeholder: "Enter amount",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mt-4">
      <div>
        <%= cf.label :cost_date, class: "block text-xs font-semibold text-gray-700 mb-1" do %>
          Date <span class="text-red-500">*</span>
        <% end %>
        <%= cf.date_field :cost_date,
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= cf.label :vendor_name, "Vendor / Contractor", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= cf.text_field :vendor_name,
            placeholder: "Vendor or contractor name (optional)",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= cf.label :invoice_number, "Invoice / Bill Number", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= cf.text_field :invoice_number,
            placeholder: "Bill or invoice reference (optional)",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mt-4">
      <div>
        <%= cf.label :invoice, "Attach Invoice / Receipt", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= cf.file_field :invoice, accept: "application/pdf,image/*",
            class: "w-full text-sm text-gray-600 file:mr-4 file:py-1.5 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100" %>
        <p class="text-xs text-gray-400 mt-2">PDF, JPG, PNG, WEBP — up to 20 MB</p>
      </div>

      <div>
        <%= cf.label :notes, class: "block text-xs font-semibold text-gray-700 mb-1" do %>
          Notes
        <% end %>
        <%= cf.text_area :notes, rows: 4, placeholder: "Any notes about this cost entry",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>
  <% end %>
</div>
