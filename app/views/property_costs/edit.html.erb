<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
  <div class="max-w-3xl mx-auto px-4 py-8">

    <div class="mb-6 flex items-center gap-2 text-sm text-gray-500">
      <%= link_to "Cost Tracker", property_costs_path, class: "text-blue-600 hover:underline" %>
      <span>/</span>
      <span class="text-gray-700 font-medium">Edit Cost Entry</span>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Cost Entry</h1>

    <% if @cost.sub_costs.any? %>
      <div class="mb-6 bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-4">
          <div>
            <h2 class="text-base font-semibold text-gray-900">Existing Sub Costs</h2>
            <p class="text-sm text-gray-500">These sub costs are linked to the main cost and will save together.</p>
          </div>
          <div class="flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
            <span class="px-3 py-2 bg-slate-100 rounded-full">Sub costs: <%= @cost.sub_costs.size %></span>
            <span class="px-3 py-2 bg-slate-100 rounded-full">Main amount: ₹<%= number_with_delimiter(@cost.amount.to_i) %></span>
            <span class="px-3 py-2 bg-slate-100 rounded-full">Sub total: ₹<%= number_with_delimiter(@cost.total_sub_cost_amount.to_i) %></span>
            <span class="px-3 py-2 bg-slate-100 rounded-full">Combined: ₹<%= number_with_delimiter(@cost.total_amount.to_i) %></span>
          </div>
        </div>
        <div class="space-y-3">
          <% @cost.sub_costs.each do |sub_cost| %>
            <div class="rounded-xl border border-gray-100 bg-slate-50 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold text-gray-800"><%= sub_cost.title %></p>
                  <p class="text-xs text-gray-500">Category: <%= sub_cost.category.humanize %> · Amount: ₹<%= number_with_delimiter(sub_cost.amount.to_i) %></p>
                </div>
                <div class="text-xs text-gray-400"><%= sub_cost.cost_date.strftime('%d %b %Y') %></div>
              </div>
              <% if sub_cost.notes.present? %>
                <p class="mt-3 text-sm text-gray-600"><%= sub_cost.notes %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render 'form' %>
  </div>
</div>
