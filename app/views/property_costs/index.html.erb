<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
          <span class="text-2xl">📊</span> Property Cost Tracker
        </h1>
        <p class="text-gray-500 text-sm mt-1">Track all investment costs across your properties & projects</p>
      </div>
      <%= link_to "Add Cost Entry", new_property_cost_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-md hover:shadow-lg transition-all" %>
    </div>

    <!-- ── FILTER BAR ─────────────────────────────────────────────────── -->

      <% form_with url: property_costs_path, method: :get, local: true,
          class: "flex flex-wrap items-end gap-3" do |f| %>

        <div class="flex-1 min-w-[160px]">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Project</label>
          <%= f.select :project_id,
              options_for_select([['All Projects', '']] + @filter_projects.map { |p| [p.name, p.id] }, params[:project_id]),
              {},
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="flex-1 min-w-[160px]">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Property</label>
          <%= f.select :property_id,
              options_for_select(
                [['All Properties', '']] +
                @filter_properties.map { |p| ["#{p.project.name} — #{p.title}", p.id] },
                params[:property_id]
              ),
              {},
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="flex-1 min-w-[220px]">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Search by Title</label>
          <%= f.text_field :query,
              value: params[:query],
              placeholder: "Search cost title...",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="min-w-[140px]">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Category</label>
          <%= f.select :category,
              options_for_select(
                [['All Categories', '']] +
                PropertyCost::CATEGORIES.map { |c| [c.humanize, c] },
                params[:category]
              ),
              {},
              class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="flex gap-2">
          <%= f.submit "Filter",
              class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium cursor-pointer transition-colors" %>
          <%= link_to "Clear", property_costs_path,
              class: "px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium transition-colors" %>
        </div>
      <% end %>


    <!-- Active filter pills -->
    <% if @filter_property || @filter_project || @filter_category || @filter_query %>
      <div class="flex flex-wrap gap-2 mb-5">
        <span class="text-xs text-gray-500 self-center">Filtering by:</span>
        <% if @filter_project %>
          <span class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-medium">
            Project: <%= @filter_project.name %>
          </span>
        <% end %>
        <% if @filter_property %>
          <span class="inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
            Property: <%= @filter_property.title %>
          </span>
        <% end %>
        <% if @filter_category %>
          <span class="inline-flex items-center gap-1 px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">
            Category: <%= @filter_category.humanize %>
          </span>
        <% end %>
        <% if @filter_query %>
          <span class="inline-flex items-center gap-1 px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
            Title: <%= @filter_query %>
          </span>
        <% end %>
      </div>
    <% end %>

    <!-- ── SUMMARY CARDS ──────────────────────────────────────────────── -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Total Invested</p>
        <p class="text-2xl font-bold text-gray-900">₹<%= number_with_delimiter(@total_invested.to_i) %></p>
        <p class="text-xs text-gray-400 mt-1"><%= @costs.count %> entries</p>
      </div>

      <% top_cat = @by_category.max_by { |_, v| v }&.first %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Top Category</p>
        <p class="text-lg font-bold text-gray-900"><%= top_cat&.humanize || '—' %></p>
        <p class="text-xs text-gray-400 mt-1">
          <%= top_cat ? "₹#{number_with_delimiter(@by_category[top_cat].to_i)}" : 'No data yet' %>
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Properties Tracked</p>
        <p class="text-2xl font-bold text-gray-900"><%= @property_summaries.count %></p>
        <p class="text-xs text-gray-400 mt-1">with cost records</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Avg Cost / Entry</p>
        <% if @costs.any? %>
          <p class="text-2xl font-bold text-gray-900">
            ₹<%= number_with_delimiter((@total_invested / @costs.count).to_i) %>
          </p>
          <p class="text-xs text-gray-400 mt-1">per entry avg</p>
        <% else %>
          <p class="text-xl font-bold text-gray-300">—</p>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">

      <!-- ── CATEGORY BREAKDOWN ─────────────────────────────────────── -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-blue-400 px-5 py-3">
          <h2 class="text-sm font-bold text-white">Cost by Category</h2>
        </div>
        <div class="p-5 space-y-3">
          <% if @by_category.any? %>
            <% @by_category.sort_by { |_, v| -v }.each do |cat, amt| %>
              <% pct = @max_category_amt > 0 ? (amt / @max_category_amt * 100).round : 0 %>
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="font-medium text-gray-700"><%= cat.humanize %></span>
                  <span class="text-gray-500 font-semibold">₹<%= number_with_delimiter(amt.to_i) %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2">
                  <div class="h-2 rounded-full bg-blue-500 transition-all" style="width: <%= pct %>%"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-400 text-center py-6">No cost data yet.</p>
          <% end %>
        </div>
      </div>

      <!-- ── PER-PROPERTY SUMMARY ───────────────────────────────────── -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gradient-to-r from-teal-600 to-teal-400 px-5 py-3">
          <h2 class="text-sm font-bold text-white">Cost vs. Sale Price — Per Property</h2>
        </div>
        <% if @property_summaries.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                  <th class="text-left text-xs text-gray-500 font-semibold px-5 py-3">Property</th>
                  <th class="text-right text-xs text-gray-500 font-semibold px-4 py-3">Total Cost</th>
                  <th class="text-right text-xs text-gray-500 font-semibold px-5 py-3">Entries</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                <% @property_summaries.each do |prop, cost_total| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-5 py-3">
                      <p class="font-medium text-gray-800 text-xs">
                        <%= link_to prop.title, project_property_path(prop.project, prop),
                            class: "hover:text-blue-600 hover:underline" %>
                      </p>
                      <p class="text-xs text-gray-400"><%= prop.project.name %> &bull; Unit <%= prop.unit_number %></p>
                    </td>
                    <td class="px-4 py-3 text-right font-semibold text-gray-900 text-xs">
                      ₹<%= number_with_delimiter(cost_total.to_i) %>
                    </td>
                    <td class="px-5 py-3 text-right text-xs text-gray-500">
                      <%= policy_scope(PropertyCost).where(property_id: prop.id).count %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center py-12 text-gray-400">
            <svg class="w-10 h-10 mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <p class="text-sm">Link cost entries to properties to see cost breakdown by property.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- ── COST ENTRIES TABLE ─────────────────────────────────────────── -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="bg-gradient-to-r from-gray-700 to-gray-500 px-5 py-3 flex items-center justify-between">
        <h2 class="text-sm font-bold text-white">Cost Entries</h2>
        <span class="text-xs text-gray-300"><%= @pagy ? @pagy.count : @main_costs.count %> entries</span>
      </div>

      <% if @main_costs.any? %>
        <div class="divide-y divide-gray-100">
          <!-- Table headers for cost list -->
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 uppercase font-semibold">
            <div class="flex items-center justify-between">
              <div class="flex-1 min-w-0">
                Cost / Property
              </div>
              <div class="flex items-center gap-4 flex-shrink-0 text-right">
                <div class="w-40 text-right">Category • Date</div>
                <div class="w-32 text-right">Amount</div>
                <div class="w-28 text-right">Actions</div>
              </div>
            </div>
          </div>
          <% @main_costs.each_with_index do |cost, index| %>
            <div class="px-6 py-3 transition-colors cursor-pointer group <%= index.even? ? 'bg-white' : 'bg-slate-100' %> hover:bg-blue-50" data-cost-modal-url="<%= property_cost_path(cost, modal: true) %>">
              <div class="flex items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3">
                    <div>
                      <p class="font-medium text-gray-900 text-sm truncate"><%= cost.title %></p>
                      <p class="text-xs text-gray-500 mt-0.5">
                        <% if cost.property %>
                          <%= cost.property.title %> • <%= cost.property.project.name %>
                        <% elsif cost.project %>
                          <%= cost.project.name %>
                        <% else %>
                          Standalone
                        <% end %>
                      </p>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2 flex-shrink-0">
                  <span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700">
                    <%= cost.category.humanize %>
                  </span>
                  <% if cost.sub_costs.any? %>
                    <span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-orange-50 text-orange-700">
                      +<%= cost.sub_costs.count %>
                    </span>
                  <% end %>
                  <span class="text-xs text-gray-500"><%= cost.cost_date.strftime('%d %b %Y') %></span>
                </div>

                <div class="text-right flex-shrink-0 min-w-[120px]">
                  <p class="font-semibold text-gray-900">₹<%= number_with_delimiter(cost.total_amount.to_i) %></p>
                  <% if cost.sub_costs.any? %>
                    <p class="text-xs text-gray-500">+<%= cost.sub_costs.count %> sub</p>
                  <% end %>
                </div>

                <div class="flex items-center gap-1 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" onclick="event.stopPropagation();">
                  <% if cost.invoice.attached? %>
                      <a href="<%= rails_blob_path(cost.invoice, disposition: 'attachment') %>"
                        data-turbo="false"
                        target="_blank"
                        download
                        class="p-1.5 rounded-lg bg-transparent hover:bg-slate-100 text-slate-500 transition-colors"
                        title="Download invoice">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                      </svg>
                    </a>
                  <% end %>
                  <a href="<%= edit_property_cost_path(cost) %>"
                    class="p-1.5 rounded-lg bg-transparent hover:bg-blue-50 text-blue-500 transition-colors"
                    title="Edit">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </a>
                  <form action="<%= property_cost_path(cost) %>" method="post" class="inline-block">
                    <input type="hidden" name="_method" value="delete" />
                    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
                    <button type="submit" data-turbo-confirm="Delete '<%= cost.title %>' and its <%= cost.sub_costs.count %> sub-costs?" class="p-1.5 rounded-lg bg-transparent hover:bg-red-50 text-red-400 transition-colors" title="Delete">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Total Summary -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-t border-gray-100 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Total Investment</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">₹<%= number_with_delimiter(@total_invested.to_i) %></p>
          </div>
          <div class="text-right text-sm text-gray-600">
            <p><%= @main_cost_count %> costs • <%= @sub_cost_count %> sub-costs</p>
          </div>
        </div>

        <% if @pagy && @pagy.pages > 1 %>
          <div class="px-6 py-4 border-t border-gray-100 bg-white">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
              <p class="text-sm text-gray-500 order-2 sm:order-1">
                Showing
                <span class="font-semibold text-gray-800"><%= @pagy.from %></span>
                –
                <span class="font-semibold text-gray-800"><%= @pagy.to %></span>
                of
                <span class="font-semibold text-gray-800"><%= @pagy.count %></span>
                costs
              </p>
              <div class="flex items-center gap-1.5 order-1 sm:order-2">
                <% if @pagy.previous %>
                  <% prev_url = @pagy.previous == 1 ? url_for(request.query_parameters.except("page")) : url_for(request.query_parameters.merge("page" => @pagy.previous)) %>
                  <%= link_to prev_url, class: "inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-600 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    <span class="hidden sm:inline">Prev</span>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-200 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    <span class="hidden sm:inline">Prev</span>
                  </span>
                <% end %>

                <% pagy_series(@pagy).each do |item| %>
                  <% if item == :gap %>
                    <span class="inline-flex items-center justify-center w-9 h-9 text-gray-400 text-sm select-none">…</span>
                  <% elsif item.is_a?(String) %>
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-600 text-white text-sm font-bold shadow-md ring-2 ring-blue-200"><%= item %></span>
                  <% else %>
                    <% page_url = item == 1 ? url_for(request.query_parameters.except("page")) : url_for(request.query_parameters.merge("page" => item)) %>
                    <%= link_to item, page_url, class: "inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" %>
                  <% end %>
                <% end %>

                <% if @pagy.next %>
                  <% next_url = url_for(request.query_parameters.merge("page" => @pagy.next)) %>
                  <%= link_to next_url, class: "inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-300 bg-white text-sm font-medium text-gray-600 hover:bg-blue-50 hover:border-blue-400 hover:text-blue-600 transition-colors shadow-sm" do %>
                    <span class="hidden sm:inline">Next</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-gray-200 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed shadow-sm">
                    <span class="hidden sm:inline">Next</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div id="cost-detail-modal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/50 p-4">
          <div class="w-full max-w-3xl rounded-3xl bg-white shadow-2xl ring-1 ring-black/5">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Cost details</h2>
                <p class="text-sm text-gray-500">Full cost and sub-cost details for the selected entry.</p>
              </div>
              <button id="close-cost-modal" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200">
                <span class="sr-only">Close</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
            <div id="cost-modal-content" class="max-h-[80vh] overflow-y-auto px-6 py-5"></div>
          </div>
        </div>

        <script>
          document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('cost-detail-modal');
            const modalContent = document.getElementById('cost-modal-content');
            const closeModalButton = document.getElementById('close-cost-modal');

            function closeModal() {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              modalContent.innerHTML = '';
            }

            function openModalWithUrl(url) {
              if (!url) return;
              modalContent.innerHTML = '<div class="py-16 text-center text-sm text-gray-500">Loading details...</div>';
              modal.classList.remove('hidden');
              modal.classList.add('flex');

              fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => {
                  if (!response.ok) throw new Error('Failed to load cost details');
                  return response.text();
                })
                .then(html => {
                  modalContent.innerHTML = html;
                })
                .catch(error => {
                  modalContent.innerHTML = '<div class="py-16 text-center text-sm text-red-500">Unable to load details. Refresh the page and try again.</div>';
                });
            }

            // Hook row clicks to open modal
            document.querySelectorAll('[data-cost-modal-url]').forEach(function(row) {
              row.addEventListener('click', function(e) {
                // Don't open modal if clicking buttons/forms
                if (e.target.closest('a, button, form')) return;
                const url = row.getAttribute('data-cost-modal-url');
                openModalWithUrl(url);
              });
            });

            closeModalButton.addEventListener('click', closeModal);
            modal.addEventListener('click', function(event) {
              if (event.target === modal) {
                closeModal();
              }
            });
          });
        </script>
      <% else %>
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
          <svg class="w-14 h-14 mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <p class="text-base font-medium text-gray-500 mb-1">No cost entries yet</p>
          <p class="text-sm text-gray-400 mb-5">Start tracking your property investment costs.</p>
