<div class="space-y-6">
  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-xs uppercase tracking-wide text-gray-500">Category</p>
      <p class="mt-2 font-semibold text-gray-800"><%= cost.category.humanize %></p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-xs uppercase tracking-wide text-gray-500">Project / Property</p>
      <p class="mt-2 font-semibold text-gray-800"><%= cost.project&.name || "-" %> / <%= cost.property&.title || "-" %></p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-xs uppercase tracking-wide text-gray-500">Cost Date</p>
      <p class="mt-2 font-semibold text-gray-800"><%= cost.cost_date.strftime('%d %b %Y') %></p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-xs uppercase tracking-wide text-gray-500">Main Amount</p>
      <p class="mt-2 text-2xl font-bold text-gray-900">₹<%= number_with_delimiter(cost.amount.to_i) %></p>
    </div>
  </div>

  <% if cost.notes.present? %>
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Notes</h2>
      <p class="text-sm text-gray-600"><%= cost.notes %></p>
    </div>
  <% end %>

  <% if cost.invoice.attached? %>
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-gray-900 mb-4">Main Cost Document</h2>
      <div class="space-y-4">
        <% if cost.invoice.image? %>
          <div class="rounded-lg overflow-hidden border border-gray-200 bg-gray-50">
            <%= image_tag url_for(cost.invoice), alt: cost.invoice.filename.to_s, class: "w-full h-auto max-h-96 object-contain" %>
          </div>
        <% end %>
        <div class="flex items-center justify-between">
          <p class="text-sm text-gray-600"><%= cost.invoice.filename.to_s %></p>
          <%= link_to "Download", rails_blob_path(cost.invoice, disposition: 'attachment'), data: { turbo: false }, target: "_blank", download: true, class: "inline-flex items-center gap-2 rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if cost.sub_costs.any? %>
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-base font-semibold text-gray-900">Sub Costs</h2>
          <p class="text-sm text-gray-500">This cost entry includes sub costs attached to the main cost.</p>
        </div>
        <div class="text-right text-sm text-slate-500">
          <div>Sub cost count: <%= cost.sub_costs.size %></div>
          <div>Sub total: ₹<%= number_with_delimiter(cost.total_sub_cost_amount.to_i) %></div>
        </div>
      </div>

      <div class="space-y-4">
        <% cost.sub_costs.each do |sub_cost| %>
          <div class="rounded-xl border border-gray-100 bg-slate-50 p-4">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-3">
              <div>
                <p class="font-semibold text-gray-800"><%= sub_cost.title %></p>
                <p class="text-sm text-gray-500">Category: <%= sub_cost.category.humanize %></p>
              </div>
              <div class="text-sm font-semibold text-gray-900">₹<%= number_with_delimiter(sub_cost.amount.to_i) %></div>
            </div>
            <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
              <div><%= sub_cost.cost_date.strftime('%d %b %Y') %></div>
              <% if sub_cost.notes.present? %>
                <span><%= truncate(sub_cost.notes, length: 80) %></span>
              <% end %>
            </div>
            <% if sub_cost.invoice.attached? %>
              <div class="mt-3 pt-3 border-t border-gray-200 space-y-2">
                <% if sub_cost.invoice.image? %>
                  <div class="rounded-lg overflow-hidden border border-gray-200 bg-white">
                    <%= image_tag url_for(sub_cost.invoice), alt: sub_cost.invoice.filename.to_s, class: "w-full h-auto max-h-48 object-contain" %>
                  </div>
                <% end %>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-gray-500"><%= sub_cost.invoice.filename.to_s %></p>
                  <%= link_to "Download", rails_blob_path(sub_cost.invoice, disposition: 'attachment'), data: { turbo: false }, target: "_blank", download: true, class: "text-xs px-2 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-gray-900 mb-4">Total Breakdown</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <span class="text-sm text-gray-600">Main Cost Amount</span>
          <span class="text-lg font-semibold text-gray-900">₹<%= number_with_delimiter(cost.amount.to_i) %></span>
        </div>
        <% if cost.sub_costs.any? %>
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-sm text-gray-600">Sub Costs (<%= cost.sub_costs.size %>)</span>
            <span class="text-lg font-semibold text-orange-700">+ ₹<%= number_with_delimiter(cost.total_sub_cost_amount.to_i) %></span>
          </div>
          <div class="flex items-center justify-between bg-gradient-to-r from-blue-50 to-indigo-50 p-3 rounded-lg">
            <span class="font-semibold text-gray-900">Combined Total</span>
            <span class="text-2xl font-bold text-gray-900">₹<%= number_with_delimiter(cost.total_amount.to_i) %></span>
          </div>
        <% else %>
          <div class="flex items-center justify-between bg-gradient-to-r from-blue-50 to-indigo-50 p-3 rounded-lg">
            <span class="font-semibold text-gray-900">Total</span>
            <span class="text-2xl font-bold text-gray-900">₹<%= number_with_delimiter(cost.amount.to_i) %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Total</h2>
      <p class="text-3xl font-bold text-gray-900">₹<%= number_with_delimiter(cost.amount.to_i) %></p>
    </div>
  <% end %>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to "Edit cost", edit_property_cost_path(cost), class: "inline-flex items-center rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    <%= link_to "Open full page", property_cost_path(cost), class: "inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</div>
