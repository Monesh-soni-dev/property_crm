<div class="mt-6 text-center">
  <div class="mx-auto h-px w-24 bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="mt-4 grid gap-2">
  <%- if controller_name != 'sessions' %>
    <p class="text-sm"><%= link_to "Back to log in", new_session_path(resource_name), class: "inline-flex items-center justify-center rounded-md px-3 py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-medium transition" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="text-sm"><%= link_to "Create an account", new_registration_path(resource_name), class: "inline-flex items-center justify-center rounded-md px-3 py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-medium transition" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p class="text-sm"><%= link_to "Forgot password? Reset it", new_password_path(resource_name), class: "inline-flex items-center justify-center rounded-md px-3 py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-medium transition" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p class="text-sm"><%= link_to "Didn't receive the confirmation email?", new_confirmation_path(resource_name), class: "inline-flex items-center justify-center rounded-md px-3 py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-medium transition" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p class="text-sm"><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: "inline-flex items-center justify-center rounded-md px-3 py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 font-medium transition" %></p>
  <% end %>

  <%# OmniAuth sign-in options intentionally disabled %>
  </div>
</div>
