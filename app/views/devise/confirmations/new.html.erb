<div class="bg-white rounded-lg shadow-md border border-gray-200 p-8 max-w-xl mx-auto">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-blue-100 mb-4">
      <svg class="w-7 h-7 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l8.89 5.45a2 2 0 002.22 0L23 8m-20 9h18a2 2 0 002-2V7a2 2 0 00-2-2H3a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Resend Confirmation Email</h1>
    <p class="text-gray-600">Enter your email address and we will send fresh confirmation instructions.</p>
    <p class="mt-2 text-xs text-gray-500">This works only for accounts that are not confirmed yet.</p>
  </div>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), local: true, html: { method: :post }) do |f| %>
    <div class="space-y-5">
      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
            class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition",
            placeholder: "your@email.com" %>
      </div>

      <%= f.submit "Resend confirmation instructions", class: "w-full bg-blue-600 text-white font-semibold py-2.5 rounded-lg hover:bg-blue-700 transition" %>
    </div>
  <% end %>

  <div class="mt-6 pt-5 border-t border-gray-200 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
