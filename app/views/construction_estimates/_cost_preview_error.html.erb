<div class="bg-white rounded-2xl border border-rose-200 p-6">
  <h3 class="text-lg font-semibold text-rose-800 mb-3">Validation Errors</h3>
  <ul class="list-disc pl-5 text-sm text-rose-700 space-y-1">
    <% errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
</div>
