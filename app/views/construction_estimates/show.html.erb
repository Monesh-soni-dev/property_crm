<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-3">
      <%= link_to construction_estimates_path, class: "text-slate-400 hover:text-slate-600 transition" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @estimate.city %> &mdash; Construction Estimate</h1>
        <p class="text-sm text-slate-500 mt-1">Created <%= @estimate.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= quality_tier_badge(@estimate.quality_tier) %>
      <%= status_badge(@estimate.status) %>
      <%= link_to edit_construction_estimate_path(@estimate), class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Edit
      <% end %>
      <%= link_to construction_estimate_path(@estimate), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Delete this estimate?" }, class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-rose-700 bg-white border border-rose-200 rounded-lg hover:bg-rose-50 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
      <p class="text-xs text-slate-400 uppercase tracking-wide">Total Cost</p>
      <p class="text-2xl font-bold text-slate-900 mt-1"><%= number_to_indian_currency(@estimate.total_estimated_cost) %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
      <p class="text-xs text-slate-400 uppercase tracking-wide">Cost / sqft</p>
      <p class="text-2xl font-bold text-emerald-600 mt-1">₹<%= number_with_delimiter(@estimate.cost_per_sqft.to_i) %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
      <p class="text-xs text-slate-400 uppercase tracking-wide">Plot Area</p>
      <p class="text-2xl font-bold text-slate-900 mt-1"><%= number_with_delimiter(@estimate.plot_area.to_i) %> <span class="text-sm font-normal text-slate-500">sqft</span></p>
      <p class="text-xs text-slate-400"><%= @estimate.plot_length.to_i %> × <%= @estimate.plot_width.to_i %> ft</p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
      <p class="text-xs text-slate-400 uppercase tracking-wide">Construction</p>
      <p class="text-2xl font-bold text-slate-900 mt-1"><%= number_with_delimiter(@estimate.construction_area.to_i) %> <span class="text-sm font-normal text-slate-500">sqft</span></p>
      <p class="text-xs text-slate-400"><%= @estimate.number_of_floors %> floor<%= @estimate.number_of_floors > 1 ? 's' : '' %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left: Plot Visualization + Material Breakdown -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Plot Visualization -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6" data-controller="plot-visualizer" data-plot-visualizer-length-value="<%= @estimate.plot_length %>" data-plot-visualizer-width-value="<%= @estimate.plot_width %>" data-plot-visualizer-construction-area-value="<%= @estimate.construction_area %>">
        <h2 class="text-lg font-semibold text-slate-900 mb-4">Plot Layout</h2>
        <div data-plot-visualizer-target="canvas" class="w-full bg-slate-50 rounded-lg border border-slate-200" style="min-height: 250px;"></div>
      </div>

      <!-- Material Breakdown -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6" data-controller="material-breakdown">
        <h2 class="text-lg font-semibold text-slate-900 mb-4">Material Breakdown</h2>
        <%= render partial: "construction_estimates/material_breakdown", locals: { grouped_materials: @grouped_materials, estimate: @estimate, result: @result } %>
      </div>
    </div>

    <!-- Right: Cost Summary -->
    <div class="lg:col-span-1 space-y-4">
      <% if @result&.success? %>
        <!-- Cost Distribution -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Cost Summary</h3>
          <div class="space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-slate-500">Material Cost</span>
              <span class="font-medium"><%= number_to_indian_currency(@result.material_total) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-500">Labor (<%= @result.labor_percentage %>%)</span>
              <span class="font-medium"><%= number_to_indian_currency(@result.labor_cost) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-slate-500">Contingency (10%)</span>
              <span class="font-medium"><%= number_to_indian_currency(@result.contingency) %></span>
            </div>
            <hr class="border-slate-200">
            <div class="flex justify-between font-semibold">
              <span class="text-slate-900">Grand Total</span>
              <span class="text-blue-700"><%= number_to_indian_currency(@result.grand_total) %></span>
            </div>
          </div>

          <!-- Pie-chart-like distribution -->
          <div class="mt-6">
            <p class="text-xs text-slate-500 mb-2">Distribution</p>
            <div class="flex h-4 rounded-full overflow-hidden">
              <div class="bg-blue-500" style="width: <%= cost_percentage(@result.material_total, @result.grand_total) %>%"></div>
              <div class="bg-emerald-500" style="width: <%= cost_percentage(@result.labor_cost, @result.grand_total) %>%"></div>
              <div class="bg-amber-500" style="width: <%= cost_percentage(@result.contingency, @result.grand_total) %>%"></div>
            </div>
            <div class="grid grid-cols-3 gap-2 mt-3 text-xs">
              <div class="text-center">
                <span class="inline-block w-2 h-2 rounded-full bg-blue-500 mr-1"></span>
                <span class="text-slate-500">Materials</span>
                <p class="font-semibold text-slate-700"><%= cost_percentage(@result.material_total, @result.grand_total) %>%</p>
              </div>
              <div class="text-center">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1"></span>
                <span class="text-slate-500">Labor</span>
                <p class="font-semibold text-slate-700"><%= cost_percentage(@result.labor_cost, @result.grand_total) %>%</p>
              </div>
              <div class="text-center">
                <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1"></span>
                <span class="text-slate-500">Other</span>
                <p class="font-semibold text-slate-700"><%= cost_percentage(@result.contingency, @result.grand_total) %>%</p>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Quick Info -->
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-100 p-6">
        <h3 class="text-sm font-semibold text-blue-900 mb-3">Estimate Details</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-blue-700/70">City</dt>
            <dd class="font-medium text-blue-900"><%= @estimate.city %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-blue-700/70">Quality</dt>
            <dd class="font-medium text-blue-900"><%= @estimate.quality_tier.capitalize %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-blue-700/70">FAR</dt>
            <dd class="font-medium text-blue-900"><%= @estimate.far_for_city %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-blue-700/70">Max Floors</dt>
            <dd class="font-medium text-blue-900"><%= @estimate.max_floors_for_city %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
