<section class="space-y-8">
  <div class="grid gap-6 xl:grid-cols-[1.3fr_0.9fr]">
    <div class="rounded-3xl bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.24),_transparent_42%),linear-gradient(135deg,#0f172a,#172554)] px-8 py-10 text-white shadow-xl shadow-slate-300/40">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-cyan-200 px-3 py-1 text-xs font-semibold text-slate-950 shadow-sm"><%= @construction_estimate.city %></span>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-900 shadow-sm"><%= @construction_estimate.quality_tier.titleize %></span>
            <span class="rounded-full bg-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-950 shadow-sm"><%= @construction_estimate.status.titleize %></span>
          </div>
          <h1 class="mt-5 text-4xl font-semibold tracking-tight"><%= @construction_estimate.property&.title || "Estimate ##{@construction_estimate.id}" %></h1>
          <p class="mt-4 max-w-2xl text-sm text-white">Plot size <%= @construction_estimate.plot_length.to_f.round(2) %> ft x <%= @construction_estimate.plot_width.to_f.round(2) %> ft with <%= pluralize(@construction_estimate.number_of_floors, 'floor') %>. Shared link ready for client review.</p>
        </div>
        <div class="text-left xl:text-right">
          <p class="text-sm text-white">Grand Total</p>
          <p class="mt-2 text-4xl font-semibold"><%= number_to_currency(@construction_estimate.total_estimated_cost, unit: '₹') %></p>
          <p class="mt-3 text-sm text-white"><%= number_to_currency(@construction_estimate.cost_per_sqft, unit: '₹') %> per sqft</p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-slate-950/30 p-3">
        <div class="flex flex-wrap gap-3">
        <% unless action_name == 'share' %>
          <%= link_to 'Edit Estimate', edit_construction_estimate_path(@construction_estimate), class: 'inline-flex items-center justify-center rounded-full bg-cyan-300 px-6 py-3 text-sm font-semibold text-slate-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-cyan-200' %>
          <%= link_to 'Download PDF', export_pdf_construction_estimate_path(@construction_estimate), class: 'inline-flex items-center justify-center rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-blue-700' %>
          <%= button_to 'Email Estimate', email_estimate_construction_estimate_path(@construction_estimate), method: :post, params: { email: current_user.email }, form_class: 'inline-flex', class: 'inline-flex items-center justify-center rounded-full bg-emerald-200 px-6 py-3 text-sm font-semibold text-emerald-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-emerald-100' %>
        <% end %>
        <%= link_to 'Share Link', share_construction_estimate_path(@construction_estimate.share_token), class: 'inline-flex items-center justify-center rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-blue-700' %>
        </div>
      </div>
    </div>

    <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Summary</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Plot Area</p>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @construction_estimate.plot_area.to_f.round(2) %> sqft</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Construction Area</p>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @construction_estimate.construction_area.to_f.round(2) %> sqft</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Buildable Footprint</p>
          <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @construction_estimate.buildable_area.to_f.round(2) %> sqft</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Version</p>
          <p class="mt-2 text-2xl font-semibold text-slate-900">v<%= @construction_estimate.version_number %></p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Builder</p>
          <p class="mt-2 text-lg font-semibold text-slate-900"><%= @construction_estimate.user.full_name %></p>
          <p class="mt-1 text-xs text-slate-500"><%= [@construction_estimate.user.mobile_number, @construction_estimate.builder_location].compact_blank.join(' | ') %></p>
        </div>
      </div>
    </aside>
  </div>

  <section class="space-y-6">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Project Facts</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Construction planning summary</h2>
        </div>
        <span class="rounded-full border border-sky-200 bg-sky-100 px-4 py-2 text-xs font-semibold text-sky-900">FAR <%= @calculation.dig(:area, 'far') || @calculation.dig(:area, :far) %></span>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Max FAR Area</p>
          <p class="mt-2 text-lg font-semibold text-slate-900"><%= (@calculation.dig(:area, 'max_construction_area') || @calculation.dig(:area, :max_construction_area)).to_f.round(2) %> sqft</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Floors</p>
          <p class="mt-2 text-lg font-semibold text-slate-900"><%= @construction_estimate.number_of_floors %></p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Shared URL</p>
          <p class="mt-2 break-all text-sm font-medium text-slate-900"><%= share_construction_estimate_url(@construction_estimate.share_token) %></p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Cost Distribution</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Materials, labor and other charges</h2>
        </div>
      </div>

      <% percentages = @construction_estimate.distribution_percentages %>
      <div class="mt-6 overflow-hidden rounded-full bg-slate-100">
        <div class="flex h-5 w-full">
          <div class="bg-sky-500" style="width: <%= percentages.fetch(:materials, 0) %>%"></div>
          <div class="bg-emerald-500" style="width: <%= percentages.fetch(:labor, 0) %>%"></div>
          <div class="bg-amber-400" style="width: <%= percentages.fetch(:other, 0) %>%"></div>
        </div>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-slate-600">Materials</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= percentages.fetch(:materials, 0) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-slate-600">Labor</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= percentages.fetch(:labor, 0) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-slate-600">Other</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= percentages.fetch(:other, 0) %>%</p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Material Breakdown</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Category-wise pricing</h2>
        </div>
      </div>
      <div class="mt-6">
        <%= render 'material_breakdown', estimate: @construction_estimate, calculation: @calculation.deep_symbolize_keys %>
      </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Builder Adjustments</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Local market overrides</h2>
      </div>

      <% adjustments = @calculation.deep_symbolize_keys[:builder_adjustments] || {} %>
      <% summary = @calculation.deep_symbolize_keys[:summary] || {} %>
      <% manual_rates = adjustments[:material_rates] || adjustments['material_rates'] || {} %>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Market Adjustment</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= adjustments.fetch(:market_adjustment_percentage, adjustments['market_adjustment_percentage'] || 0) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Labor</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= summary.fetch(:labor_percentage, summary['labor_percentage'] || @construction_estimate.labor_percentage) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Overhead</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= summary.fetch(:overhead_percentage, summary['overhead_percentage'] || @construction_estimate.overhead_percentage) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Contingency</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= summary.fetch(:contingency_percentage, summary['contingency_percentage'] || @construction_estimate.contingency_percentage) %>%</p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Electrical Override</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= @construction_estimate.electrical_rate_per_sqft.present? ? number_to_currency(@construction_estimate.electrical_rate_per_sqft, unit: '₹') : 'Market default' %></p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-4">
          <p class="text-sm text-slate-600">Plumbing Override</p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= @construction_estimate.plumbing_rate_per_sqft.present? ? number_to_currency(@construction_estimate.plumbing_rate_per_sqft, unit: '₹') : 'Market default' %></p>
        </div>
      </div>

      <div class="mt-6 rounded-3xl border border-slate-200 overflow-hidden">
        <div class="bg-slate-50 px-5 py-4">
          <p class="text-sm font-semibold text-slate-900">Manual material rates entered by builder</p>
          <p class="mt-1 text-xs text-slate-500">Blank values mean the estimate used the market reference available for that city and quality tier.</p>
        </div>
        <div class="overflow-x-auto bg-white">
          <table class="min-w-full divide-y divide-slate-200 text-sm text-slate-700">
            <thead class="bg-white text-xs uppercase tracking-[0.2em] text-slate-400">
              <tr>
                <th class="px-5 py-3 text-left">Material</th>
                <th class="px-5 py-3 text-left">Meaning</th>
                <th class="px-5 py-3 text-right">Builder Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% ConstructionEstimate.material_rate_fields.each do |field| %>
                <% rate_value = manual_rates[field[:key]] || manual_rates[field[:key].to_sym] %>
                <tr>
                  <td class="px-5 py-4 font-medium text-slate-900"><%= field[:label] %></td>
                  <td class="px-5 py-4 text-slate-600"><%= field[:description] %></td>
                  <td class="px-5 py-4 text-right font-semibold text-slate-900"><%= rate_value.present? ? number_to_currency(rate_value, unit: '₹') : 'Market default' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>