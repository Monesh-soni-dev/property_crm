<section class="space-y-8">
  <div class="flex flex-col gap-4 rounded-3xl bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.24),_transparent_42%),linear-gradient(135deg,#0f172a,#172554)] px-8 py-10 text-white shadow-xl shadow-slate-300/40 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.4em] text-cyan-200">Construction Costing</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">Estimate dashboard</h1>
      <p class="mt-4 max-w-2xl text-sm text-slate-100/90">Model plot configurations, compare multiple scenarios, and export client-ready construction cost reports.</p>
    </div>
    <%= link_to 'New Estimate', new_construction_estimate_path, class: 'inline-flex items-center justify-center rounded-full bg-cyan-300 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-200' %>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm text-slate-600">Saved estimates</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= @construction_estimates.size %></p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm text-slate-600">Finalized</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= @construction_estimates.count(&:finalized?) %></p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm text-slate-600">Average rate / sqft</p>
      <p class="mt-3 text-3xl font-semibold text-slate-900"><%= number_to_currency(@construction_estimates.sum(&:cost_per_sqft) / [@construction_estimates.size, 1].max, unit: '₹') %></p>
    </div>
  </div>

  <div class="grid gap-5 xl:grid-cols-2">
    <% @construction_estimates.each do |estimate| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded-full border border-sky-200 bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-900"><%= estimate.city %></span>
              <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-800"><%= estimate.quality_tier.titleize %></span>
              <span class="rounded-full border border-emerald-200 bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-900"><%= estimate.status.titleize %></span>
            </div>
            <h2 class="mt-4 text-2xl font-semibold text-slate-900"><%= estimate.property&.title || "Estimate ##{estimate.id}" %></h2>
            <p class="mt-2 text-sm text-slate-600"><%= estimate.plot_length.to_f.round(2) %> ft x <%= estimate.plot_width.to_f.round(2) %> ft plot with <%= pluralize(estimate.number_of_floors, 'floor') %></p>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm text-slate-600">Grand total</p>
            <p class="mt-1 text-2xl font-semibold text-slate-900"><%= number_to_currency(estimate.total_estimated_cost, unit: '₹') %></p>
            <p class="mt-2 text-sm text-slate-600"><%= number_to_currency(estimate.cost_per_sqft, unit: '₹') %> / sqft</p>
          </div>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-50 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Plot Area</p>
            <p class="mt-2 text-lg font-semibold text-slate-900"><%= estimate.plot_area.to_f.round(2) %> sqft</p>
          </div>
          <div class="rounded-2xl bg-slate-50 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Construction Area</p>
            <p class="mt-2 text-lg font-semibold text-slate-900"><%= estimate.construction_area.to_f.round(2) %> sqft</p>
          </div>
          <div class="rounded-2xl bg-slate-50 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Updated</p>
            <p class="mt-2 text-lg font-semibold text-slate-900"><%= time_ago_in_words(estimate.updated_at) %> ago</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <%= link_to 'Open', construction_estimate_path(estimate), class: 'rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-cyan-700' %>
          <%= link_to 'Edit', edit_construction_estimate_path(estimate), class: 'rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50' %>
          <%= link_to 'PDF', export_pdf_construction_estimate_path(estimate), class: 'rounded-full border border-sky-300 bg-sky-50 px-5 py-2.5 text-sm font-semibold text-sky-900 transition hover:bg-sky-100' %>
          <%= button_to 'Email', email_estimate_construction_estimate_path(estimate), method: :post, params: { email: current_user.email }, class: 'rounded-full border border-emerald-300 bg-emerald-50 px-5 py-2.5 text-sm font-semibold text-emerald-900 transition hover:bg-emerald-100' %>
        </div>
      </article>
    <% end %>

    <% if @construction_estimates.empty? %>
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center text-slate-600 xl:col-span-2">
        <p class="text-lg font-semibold text-slate-900">No construction estimates yet</p>
        <p class="mt-2 text-sm">Create your first estimate to compare plot options, material mixes, and client-ready pricing.</p>
      </div>
    <% end %>
  </div>
</section>