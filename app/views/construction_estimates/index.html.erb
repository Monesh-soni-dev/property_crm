<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Construction Cost Estimates</h1>
      <p class="text-sm text-slate-500 mt-1">Calculate and compare construction costs for your properties</p>
    </div>
    <%= link_to new_construction_estimate_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Estimate
    <% end %>
  </div>

  <% if @estimates.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @estimates.each do |estimate| %>
        <%= link_to construction_estimate_path(estimate), class: "block bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-md transition group" do %>
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-2">
              <%= quality_tier_badge(estimate.quality_tier) %>
              <%= status_badge(estimate.status) %>
            </div>
            <span class="text-xs text-slate-400"><%= estimate.created_at.strftime("%b %d, %Y") %></span>
          </div>

          <div class="mb-4">
            <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition">
              <%= estimate.city %> &mdash; <%= estimate.plot_area.to_i %> sqft Plot
            </h3>
            <p class="text-sm text-slate-500 mt-1">
              <%= estimate.plot_length.to_i %> × <%= estimate.plot_width.to_i %> ft
              &middot; <%= estimate.number_of_floors %> Floor<%= estimate.number_of_floors > 1 ? 's' : '' %>
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-100">
            <div>
              <p class="text-xs text-slate-400">Total Cost</p>
              <p class="text-lg font-bold text-slate-900"><%= number_to_indian_currency(estimate.total_estimated_cost) %></p>
            </div>
            <div>
              <p class="text-xs text-slate-400">Cost/sqft</p>
              <p class="text-lg font-bold text-emerald-600">₹<%= number_with_delimiter(estimate.cost_per_sqft.to_i) %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
      <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
      </svg>
      <h3 class="text-lg font-semibold text-slate-700 mb-2">No Estimates Yet</h3>
      <p class="text-slate-500 mb-6">Create your first construction cost estimate to get started.</p>
      <%= link_to "Create Estimate", new_construction_estimate_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>
