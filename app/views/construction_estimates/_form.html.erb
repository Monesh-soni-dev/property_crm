<%= form_with model: construction_estimate, class: 'space-y-8', data: {
  controller: 'cost-calculator',
  cost_calculator_url_value: calculate_costs_construction_estimates_path,
  cost_calculator_target: 'form'
} do |form| %>
  <% if construction_estimate.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-800">
      <p class="font-semibold">Please fix the following issues:</p>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <% construction_estimate.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-8 lg:grid-cols-[1.4fr_0.9fr]">
    <section class="rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-700">Estimator Inputs</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Plot and quality configuration</h2>
        </div>
        <div class="rounded-full border border-sky-100 bg-sky-50 px-4 py-2 text-xs font-semibold text-sky-800">
          Live preview
        </div>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div>
          <%= form.label :property_id, class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.collection_select :property_id, @properties, :id, :title, { include_blank: 'Standalone estimate' }, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200' %>
        </div>

        <div>
          <%= form.label :city, class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.select :city, options_for_select(@city_options, construction_estimate.city), {}, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900', data: { action: 'change->cost-calculator#calculate input->cost-calculator#calculate' } %>
        </div>

        <div>
          <%= form.label :plot_length, 'Plot Length (ft)', class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.number_field :plot_length, step: 0.01, min: 1, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
        </div>

        <div>
          <%= form.label :plot_width, 'Plot Width (ft)', class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.number_field :plot_width, step: 0.01, min: 1, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
        </div>

        <div>
          <%= form.label :construction_area, 'Construction Area (sqft)', class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.number_field :construction_area, step: 0.01, min: 1, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
        </div>

        <div>
          <%= form.label :number_of_floors, class: 'mb-2 block text-sm font-medium text-slate-700' %>
          <%= form.number_field :number_of_floors, min: 1, max: 10, class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
        </div>
      </div>

      <div class="mt-8">
        <p class="text-sm font-medium text-slate-700">Quality Tier</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          <% ConstructionEstimate.quality_tiers.keys.each do |tier| %>
            <label class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-700 transition hover:border-sky-300 hover:bg-sky-50" data-cost-calculator-target="qualityOption">
              <div class="flex items-center gap-3">
                <%= form.radio_button :quality_tier, tier, class: 'h-4 w-4 border-slate-300 text-sky-600 focus:ring-sky-500', data: { cost_calculator_target: 'input', action: 'change->cost-calculator#calculate change->cost-calculator#syncSelectionStates' } %>
                <div>
                  <p class="font-semibold text-slate-900"><%= tier.titleize %></p>
                  <p class="text-xs text-slate-500"><%= tier == 'basic' ? 'Essential finishes' : tier == 'standard' ? 'Balanced cost-quality mix' : 'High-spec material selection' %></p>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="mt-8">
        <p class="text-sm font-medium text-slate-700">Status</p>
        <div class="mt-3 flex flex-wrap gap-3">
          <% ConstructionEstimate.statuses.keys.each do |estimate_status| %>
            <label class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700 transition" data-cost-calculator-target="statusOption">
              <%= form.radio_button :status, estimate_status, class: 'h-4 w-4 text-sky-600 focus:ring-sky-500', data: { action: 'change->cost-calculator#syncSelectionStates' } %>
              <span><%= estimate_status.titleize %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="mt-8 rounded-3xl border border-sky-100 bg-sky-50/60 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-700">Builder Inputs</p>
            <h3 class="mt-2 text-lg font-semibold text-slate-900">Indian market tuning</h3>
            <p class="mt-1 text-sm text-slate-600">Keep labor and overhead defaults if they match your site. Use the fields below to tune local contractor pricing and service packages.</p>
          </div>
          <div class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm">Editable</div>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <div>
            <%= form.label :market_adjustment_percentage, 'Local Market Adj. %', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :market_adjustment_percentage, step: 0.1, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Use positive or negative values for neighborhood premiums.</p>
          </div>

          <div>
            <%= form.label :labor_percentage, 'Labor %', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :labor_percentage, step: 0.1, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Typical builder range in India is 30% to 40%.</p>
          </div>

          <div>
            <%= form.label :overhead_percentage, 'Overhead %', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :overhead_percentage, step: 0.1, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Covers supervision, admin, site setup, approvals.</p>
          </div>

          <div>
            <%= form.label :contingency_percentage, 'Contingency %', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :contingency_percentage, step: 0.1, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Buffer for wastage, delays and scope changes.</p>
          </div>

          <div>
            <%= form.label :electrical_rate_per_sqft, 'Electrical Rate / sqft', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :electrical_rate_per_sqft, step: 0.01, min: 0, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', placeholder: 'Enter your own rate per sqft', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Electrical wiring, switchboard and fitting package rate for one sqft.</p>
          </div>

          <div>
            <%= form.label :plumbing_rate_per_sqft, 'Plumbing Rate / sqft', class: 'mb-2 block text-sm font-medium text-slate-700' %>
            <%= form.number_field :plumbing_rate_per_sqft, step: 0.01, min: 0, class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', placeholder: 'Enter your own rate per sqft', data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
            <p class="mt-1 text-xs text-slate-500">Water supply, drainage and bathroom piping package rate for one sqft.</p>
          </div>
        </div>
      </div>

      <div class="mt-8 rounded-3xl border border-emerald-100 bg-emerald-50/70 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700">Material Rate Inputs</p>
            <h3 class="mt-2 text-lg font-semibold text-slate-900">Enter your own purchase rates</h3>
            <p class="mt-1 text-sm text-slate-600">These are the core material rates used in the estimate. Enter your local supplier price if you already know it. If you leave a field blank, the system will use an available market rate for that city and quality tier.</p>
          </div>
          <div class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm">Manual first</div>
        </div>

        <% current_material_rates = construction_estimate.material_rates || {} %>
        <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <% @material_rate_fields.each do |field| %>
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-700" for="construction_estimate_material_rates_<%= field[:key] %>"><%= field[:label] %></label>
              <%= number_field_tag "construction_estimate[material_rates][#{field[:key]}]", current_material_rates[field[:key]], step: 0.01, min: 0, id: "construction_estimate_material_rates_#{field[:key]}", class: 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900', placeholder: field[:unit_label], data: { cost_calculator_target: 'input', action: 'input->cost-calculator#calculate' } %>
              <p class="mt-1 text-xs text-slate-500"><%= field[:description] %> <span class="font-medium text-slate-600"><%= field[:unit_label] %>.</span></p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <aside class="space-y-6">
      <section class="rounded-3xl bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.22),_transparent_42%),linear-gradient(135deg,#0f172a,#172554)] p-6 text-white shadow-xl shadow-slate-300/30">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-100">Cost Preview</p>
        <div class="mt-6 space-y-4" data-cost-calculator-target="preview">
          <div>
            <p class="text-sm text-white">Estimated Total</p>
            <p class="mt-1 text-3xl font-semibold"><%= number_to_currency(construction_estimate.total_estimated_cost, unit: '₹') %></p>
          </div>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div class="rounded-2xl border border-cyan-200/30 bg-slate-950/30 p-4">
              <p class="text-cyan-50">Rate / sqft</p>
              <p class="mt-2 text-xl font-semibold" data-cost-calculator-target="costPerSqft"><%= number_to_currency(construction_estimate.cost_per_sqft, unit: '₹') %></p>
            </div>
            <div class="rounded-2xl border border-cyan-200/30 bg-slate-950/30 p-4">
              <p class="text-cyan-50">Buildable Area</p>
              <p class="mt-2 text-xl font-semibold" data-cost-calculator-target="buildableArea"><%= construction_estimate.buildable_area.to_f.round(2) %> sqft</p>
            </div>
          </div>
          <div class="rounded-2xl border border-cyan-200/30 bg-slate-950/30 p-4 text-sm text-white">
            <div class="flex items-center justify-between">
              <span>Plot Area</span>
              <span data-cost-calculator-target="plotArea"><%= construction_estimate.plot_area.to_f.round(2) %> sqft</span>
            </div>
            <div class="mt-3 flex items-center justify-between">
              <span>Construction Area</span>
              <span data-cost-calculator-target="constructionArea"><%= construction_estimate.construction_area.to_f.round(2) %> sqft</span>
            </div>
          </div>
          <div class="hidden rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900" data-cost-calculator-target="errors"></div>
        </div>
      </section>
    </aside>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-600">Material Preview</p>
        <h3 class="mt-2 text-xl font-semibold text-slate-900">Live category breakdown</h3>
      </div>
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600">
        <span class="h-2 w-2 animate-pulse rounded-full bg-sky-500"></span>
        Updates as you type
      </div>
    </div>

    <div class="mt-6" data-cost-calculator-target="breakdownContainer">
      <%= render 'material_breakdown', estimate: construction_estimate, calculation: nil %>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-end gap-3">
    <%= link_to 'Back', construction_estimates_path, class: 'rounded-full border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50' %>
    <%= form.submit class: 'rounded-full bg-sky-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700' %>
  </div>
<% end %>
