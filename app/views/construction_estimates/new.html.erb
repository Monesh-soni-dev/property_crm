<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to construction_estimates_path, class: "text-slate-400 hover:text-slate-600 transition" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h1 class="text-2xl font-bold text-slate-900">New Construction Estimate</h1>
  </div>

  <%= render "form", estimate: @estimate %>
</div>
