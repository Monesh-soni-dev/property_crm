<% if grouped_materials.any? %>
  <div class="space-y-4">
    <% grouped_materials.each do |category_name, items| %>
      <div class="border border-slate-200 rounded-xl overflow-hidden" data-material-breakdown-target="category">
        <!-- Category Header (collapsible) -->
        <button type="button" class="w-full flex items-center justify-between px-4 py-3 bg-slate-50 hover:bg-slate-100 transition text-left" data-action="click->material-breakdown#toggle" data-category="<%= category_name %>">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400 transition-transform" data-material-breakdown-target="chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            <span class="font-semibold text-sm text-slate-700"><%= category_name %></span>
            <span class="text-xs text-slate-400">(<%= items.size %> item<%= items.size > 1 ? 's' : '' %>)</span>
          </div>
          <span class="text-sm font-semibold text-slate-900">
            ₹<%= number_with_delimiter(items.sum(&:total_price).to_i) %>
          </span>
        </button>

        <!-- Materials Table -->
        <div data-material-breakdown-target="content" class="">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-t border-slate-200 bg-white text-slate-500 text-xs uppercase tracking-wider">
                <th class="text-left px-4 py-2 font-medium">Material</th>
                <th class="text-right px-4 py-2 font-medium">Qty</th>
                <th class="text-center px-4 py-2 font-medium">Unit</th>
                <th class="text-right px-4 py-2 font-medium">Rate (₹)</th>
                <th class="text-right px-4 py-2 font-medium">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% items.each do |em| %>
                <tr class="border-t border-slate-100 hover:bg-slate-50">
                  <td class="px-4 py-2.5">
                    <p class="font-medium text-slate-700"><%= em.material_name %></p>
                    <% if em.material_specification.present? %>
                      <p class="text-xs text-slate-400"><%= em.material_specification %></p>
                    <% end %>
                  </td>
                  <td class="px-4 py-2.5 text-right text-slate-600"><%= number_with_delimiter(em.quantity.to_i) %></td>
                  <td class="px-4 py-2.5 text-center text-slate-500"><%= em.material_unit %></td>
                  <td class="px-4 py-2.5 text-right text-slate-600">₹<%= number_with_delimiter(em.unit_price.to_i) %></td>
                  <td class="px-4 py-2.5 text-right font-medium text-slate-900">₹<%= number_with_delimiter(em.total_price.to_i) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="border-t border-slate-200 bg-slate-50">
                <td colspan="4" class="px-4 py-2 text-right text-sm font-medium text-slate-600">Subtotal</td>
                <td class="px-4 py-2 text-right text-sm font-bold text-slate-900">₹<%= number_with_delimiter(items.sum(&:total_price).to_i) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    <% end %>

    <% if result&.success? %>
      <!-- Grand Total -->
      <div class="border-2 border-blue-200 rounded-xl p-4 bg-blue-50">
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-blue-700">Material Total</span>
            <span class="font-medium text-blue-900">₹<%= number_with_delimiter(result.material_total.to_i) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-blue-700">Labor (<%= result.labor_percentage %>%)</span>
            <span class="font-medium text-blue-900">₹<%= number_with_delimiter(result.labor_cost.to_i) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-blue-700">Contingency & Overhead (10%)</span>
            <span class="font-medium text-blue-900">₹<%= number_with_delimiter(result.contingency.to_i) %></span>
          </div>
          <hr class="border-blue-200">
          <div class="flex justify-between text-lg font-bold">
            <span class="text-blue-900">Grand Total</span>
            <span class="text-blue-700">₹<%= number_with_delimiter(result.grand_total.to_i) %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-8">
    <p class="text-sm text-slate-400">No material breakdown available. Try recalculating the estimate.</p>
  </div>
<% end %>
